--== Parent finder ==
local function getParent()
    local ok, h = pcall(function() return gethui() end)
    if ok and h and typeof(h) == "Instance" then return h end
    local ok2 = pcall(function() return CoreGui and CoreGui:IsA("BasePlayerGui") end)
    if ok2 and CoreGui then return CoreGui end
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then return pg end
    return WS
end
local parent = getParent()
for _, n in ipairs({"HappyHub","HappyHubUI","po"}) do
    local o = parent:FindFirstChild(n); if o then pcall(function() o:Destroy() end) end
end

