    if gp then return end
    if input.KeyCode==Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
        if Main.Visible then Main.AnchorPoint=Vector2.new(0.5,0.5); Main.Position=UDim2.new(0.5,0,0.5,0) end
    end
end)

