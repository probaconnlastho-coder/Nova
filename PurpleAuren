-- PAGE SYSTEM
--==================================================================
local Pages = {}
local function createPage(name)
    local p = mk("ScrollingFrame", {
        Name=name.."Page", Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        BorderSizePixel=0, ScrollBarThickness=5, ScrollBarImageColor3=Color3.fromRGB(0,0,0),
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
        Visible=false, ClipsDescendants=true, ZIndex=3,
    }, Content)
    local g = mk("UIGridLayout", {
        CellPadding=UDim2.new(0,6,0,4), CellSize=UDim2.new(0,104,0,40),
        SortOrder=Enum.SortOrder.LayoutOrder,
    }, p)
    mk("UIPadding",{PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,6),PaddingLeft=UDim.new(0,6),PaddingRight=UDim.new(0,6)},p)
    Pages[name] = { frame = p, grid = g, container = p }
    return p
end

local function showPage(name)
    for k,v in pairs(Pages) do v.frame.Visible = (k == name) end
end

local function sideBtn(parent, label, pageName)
    local b = mk("TextButton", {
        Size=UDim2.new(0,67,0,26), BackgroundColor3=Color3.fromRGB(0,0,0),
        BorderSizePixel=0, Text=label, TextColor3=Color3.fromRGB(255,255,255),
        TextSize=11, Font=Enum.Font.SourceSans, TextScaled=true, TextWrapped=true,
        AutoButtonColor=true, ZIndex=4, ClipsDescendants=true,
    }, parent)
    corner(b,5); grad(b)
    b.MouseButton1Click:Connect(function()
        playClick(b); ripple(b); showPage(pageName)
    end)
    return b
end

