local function makeBtn(parent, label, callback, size)
    size = size or UDim2.new(0,93,0,40)
    local b = mk("TextButton", {
        Size=size, BackgroundColor3=Color3.fromRGB(0,0,0),
        BorderSizePixel=0, Text=tostring(label), TextColor3=Color3.fromRGB(255,255,255),
        TextSize=12, Font=Enum.Font.SourceSans, TextScaled=true, TextWrapped=true,
        AutoButtonColor=true, ZIndex=4, ClipsDescendants=true,
    }, parent)
    corner(b,5); grad(b)
    b.MouseButton1Click:Connect(function()
        playClick(b); ripple(b)
        local ok, err = pcall(callback)
        if not ok then notif("Error: "..tostring(err)) end
    end)
    return b
end

