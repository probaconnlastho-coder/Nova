pcall(function()
    WS:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Main.AnchorPoint=Vector2.new(0.5,0.5); Main.Position=UDim2.new(0.5,0,0.5,0)
    end)
end)
pcall(function()
    WS.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        Main.AnchorPoint=Vector2.new(0.5,0.5); Main.Position=UDim2.new(0.5,0,0.5,0)
    end)
end)

