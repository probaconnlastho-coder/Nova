--== Helpers ==
local CLICK_SND = "rbxassetid://1673280232"
local RIP_IMG   = "rbxassetid://266543268"

local function mk(cls, props, par)
    local i = Instance.new(cls)
    for k,v in pairs(props or {}) do pcall(function() i[k]=v end) end
    if par then i.Parent = par end
    return i
end
local function corner(i,r) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 5); c.Parent=i; return c end
local function grad(i)
    local g=Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,80,80)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160,80,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(80,180,255)),
    }
    g.Parent=i; return g
end
local function notif(t,d) pcall(function() StarterGui:SetCore("SendNotification",{Title="HappyHub",Text=tostring(t),Duration=d or 3}) end) end
local function log(t) if _G.__hh_log then _G.__hh_log.Text = _G.__hh_log.Text .. tostring(t) .. "\n" end end
local function playClick(btn)
    pcall(function()
        local s = Instance.new("Sound", btn)
        s.SoundId = CLICK_SND; s.Volume = 1; s:Play()
        task.delay(2, function() pcall(function() s:Destroy() end) end)
    end)
end
local function ripple(btn)
    pcall(function()
        local c = Instance.new("ImageLabel", btn)
        c.Name = "Ripple"
        c.AnchorPoint = Vector2.new(0.5,0.5)
        c.Position = UDim2.new(0.5,0,0.5,0)
        c.Size = UDim2.new(0,0,0,0)
        c.BackgroundTransparency = 1
        c.Image = RIP_IMG
        c.ImageColor3 = Color3.fromRGB(255,255,255)
        c.ImageTransparency = 0.5
        c.ZIndex = 10
        local target = UDim2.new(0, math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y)*2, 0, math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y)*2)
        local tw = game:GetService("TweenService"):Create(c, TweenInfo.new(0.45), {Size = target, ImageTransparency = 1})
        tw:Play()
        task.delay(0.5, function() pcall(function() c:Destroy() end) end)
    end)
end

--== Client-side actions ==
local function setSky(id)
    pcall(function()
        local s = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
        s.SkyboxBk=id; s.SkyboxDn=id; s.SkyboxFt=id; s.SkyboxLf=id; s.SkyboxRt=id; s.SkyboxUp=id
    end)
end
local function setFace(id)
    pcall(function()
        local c = LP.Character; if not c then return end
        for _,d in ipairs(c:GetDescendants()) do
            if d:IsA("Decal") and (d.Name=="face" or d.Name=="Face") then d.Texture = id end
        end
    end)
end
local function jumpscare(id,t)
    t = t or 2
    local g = mk("ImageLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Image=id,ZIndex=500,ScaleType=Enum.ScaleType.Fit}, ScreenGui)
    pcall(function() local s=Instance.new("Sound",g); s.SoundId="rbxassetid://574998869"; s.Volume=3; s:Play() end)
    task.delay(t, function() pcall(function() g:Destroy() end) end)
end
local function spawnDummy()
    pcall(function()
        local c = LP.Character; if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
        if not h then return end
        local m = Instance.new("Model", WS); m.Name="HHDummy"
        Instance.new("Humanoid", m)
        local t = Instance.new("Part", m); t.Name="Torso"; t.Size=Vector3.new(2,2,1)
        t.CFrame = h.CFrame * CFrame.new(0,0,-6); t.BrickColor = BrickColor.new("Bright yellow")
        local hd = Instance.new("Part", m); hd.Name="Head"; hd.Size=Vector3.new(2,1,1)
        hd.CFrame = t.CFrame * CFrame.new(0,1.5,0); hd.BrickColor = BrickColor.new("Bright yellow")
        local f = Instance.new("Decal", hd); f.Texture="rbxasset://textures/face.png"; f.Name="Face"
    end)
end
local function giveTool(name)
    pcall(function()
        local bp = LP:FindFirstChildOfClass("Backpack") or Instance.new("Backpack",LP)
        local t = Instance.new("Tool", bp); t.Name = name or "HHTool"; t.CanBeDropped = false
        local h = Instance.new("Part", t); h.Name="Handle"; h.Size=Vector3.new(1,1,1)
        h.BrickColor = BrickColor.new("Really red"); t.Grip = CFrame.new(0,0,0)
    end)
end
local function setSpeed(n)
    pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=n end end)
end
local function setJump(n)
    pcall(function() local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.JumpPower=n end end)
end
local function resetSpeed() setSpeed(16) end
local function resetJump() setJump(50) end

