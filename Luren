local function setSky(id)
    pcall(function()
        local s = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", Lighting)
        s.SkyboxBk=id; s.SkyboxDn=id; s.SkyboxFt=id; s.SkyboxLf=id; s.SkyboxRt=id; s.SkyboxUp=id
    end)
end
local function resetSky()
    pcall(function() local sk=Lighting:FindFirstChildOfClass("Sky"); if sk then sk:Destroy() end end)
end
local function setFace(id)
    pcall(function()
        local c = LP.Character; if not c then return end
        for _,d in ipairs(c:GetDescendants()) do
            if d:IsA("Decal") and (d.Name=="face" or d.Name=="Face") then d.Texture = id end
        end
    end)
end
local function jumpscare(id, t)
    t = t or 2
    local g = mk("ImageLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Image=id,ZIndex=500,ScaleType=Enum.ScaleType.Fit}, ScreenGui)
    local s = Instance.new("Sound", g); s.SoundId=JUMP_SND; s.Volume=3; pcall(function() s:Play() end)
    task.delay(t, function() pcall(function() g:Destroy() end) end)
end
local function spawnDummy()
    pcall(function()
        local c = LP.Character; if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
        if not h then return end
        local m = Instance.new("Model", WS); m.Name="HHDummy"
        Instance.new("Humanoid", m)
        local t = Instance.new("Part", m); t.Name="Torso"; t.Size=Vector3.new(2,2,1)
        t.CFrame = h.CFrame * CFrame.new(0,0,-6); t.BrickColor = BrickColor.new("Bright yellow")
        local hd = Instance.new("Part", m); hd.Name="Head"; hd.Size=Vector3.new(2,1,1)
        hd.CFrame = t.CFrame * CFrame.new(0,1.5,0); hd.BrickColor = BrickColor.new("Bright yellow")
        local f = Instance.new("Decal", hd); f.Texture="rbxasset://textures/face.png"; f.Name="Face"
    end)
end
local function giveTool(name)
    pcall(function()
        local bp = LP:FindFirstChildOfClass("Backpack") or Instance.new("Backpack",LP)
