local CLICK_SND = "rbxassetid://1673280232"
local RIP_IMG   = "rbxassetid://266543268"
local JUMP_SND  = "rbxassetid://574998869"

local function mk(cls, props, par)
    local i = Instance.new(cls)
    for k,v in pairs(props or {}) do pcall(function() i[k]=v end) end
    if par then i.Parent = par end
    return i
end
local function corner(i,r) local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 5); c.Parent=i; return c end
local function grad(i, col1, col2, col3)
    col1 = col1 or Color3.fromRGB(255,80,80)
    col2 = col2 or Color3.fromRGB(160,80,255)
    col3 = col3 or Color3.fromRGB(80,180,255)
    local g=Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, col1),
        ColorSequenceKeypoint.new(0.5, col2),
        ColorSequenceKeypoint.new(1, col3),
    }
    g.Parent=i; return g
end
local function notif(t,d)
    pcall(function()
        StarterGui:SetCore("SendNotification",{Title="HappyHub",Text=tostring(t),Duration=d or 3})
    end)
end
local function log(t)
    if _G.__hh_log and _G.__hh_log.Parent then
        _G.__hh_log.Text = _G.__hh_log.Text .. tostring(t) .. "\n"
    end
end
local function playClick(btn)
    pcall(function()
        local s = Instance.new("Sound", btn)
        s.SoundId = CLICK_SND; s.Volume = 1; s:Play()
        task.delay(2, function() pcall(function() s:Destroy() end) end)
    end)
end
local function ripple(btn)
    pcall(function()
        local c = Instance.new("ImageLabel", btn)
        c.Name = "Ripple"
        c.AnchorPoint = Vector2.new(0.5,0.5)
        c.Position = UDim2.new(0.5,0,0.5,0)
        c.Size = UDim2.new(0,0,0,0)
        c.BackgroundTransparency = 1
        c.Image = RIP_IMG
        c.ImageColor3 = Color3.fromRGB(255,255,255)
        c.ImageTransparency = 0.5
        c.ZIndex = 10
        local target = UDim2.new(0, math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y)*2, 0, math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y)*2)
        local tw = TS:Create(c, TweenInfo.new(0.45), {Size = target, ImageTransparency = 1})
        tw:Play()
        task.delay(0.5, function() pcall(function() c:Destroy() end) end)
    end)
end

