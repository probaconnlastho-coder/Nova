--==================================================================
-- PARENT RESOLVER (universal)
--==================================================================
local function resolveParent()
    local ok, h = pcall(function()
        local fn = rawget(_G, "gethui")
        if type(fn) == "function" then return fn() end
    end)
    if ok and typeof(h) == "Instance" then return h end

    local ok2, cg = pcall(function() return CoreGuiSvc end)
    if ok2 and cg then return cg end

    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then
        local ok3, pg2 = pcall(function() return LP:WaitForChild("PlayerGui", 5) end)
        if ok3 then pg = pg2 end
    end
    return pg or WS
end
local parent = resolveParent()

for _, n in ipairs({"HappyHub","HappyHubUI","po"}) do
    for _, cont in ipairs({parent, CoreGuiSvc, LP:FindFirstChildOfClass("PlayerGui"), WS}) do
        if cont then
            local o = cont:FindFirstChild(n)
            if o then pcall(function() o:Destroy() end) end
        end
    end
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name           = "HappyHub"
ScreenGui.ResetOnSpawn   = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.IgnoreGuiInset = true
ScreenGui.DisplayOrder   = 999999
ScreenGui.Enabled        = true

local synT = rawget(_G, "syn")
if type(synT) == "table" and type(synT.protect_gui) == "function" then
    pcall(synT.protect_gui, ScreenGui)
end
local protFn = rawget(_G, "protect_gui")
if type(protFn) == "function" then pcall(protFn, ScreenGui) end

ScreenGui.Parent = parent
if not ScreenGui.Parent then
    ScreenGui.Parent = LP:WaitForChild("PlayerGui", 5) or WS
end

