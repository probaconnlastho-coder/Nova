local function sideBtn(parent, label, pageName)
    local b = mk("TextButton", {
        Size=UDim2.new(0,67,0,26), BackgroundColor3=Color3.fromRGB(0,0,0),
        BorderSizePixel=0, Text=label, TextColor3=Color3.fromRGB(255,255,255),
        TextSize=11, Font=Enum.Font.SourceSans, TextScaled=true, TextWrapped=true,
        AutoButtonColor=true, ZIndex=4, ClipsDescendants=true,
    }, parent)
    corner(b,5); grad(b)
    b.MouseButton1Click:Connect(function()
        playClick(b); ripple(b); showPage(pageName)
    end)
    return b
end

