--==================================================================
local function killAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h then h.Health = 0 end
        end
    end
end
local function freezeAll(s)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _, d in ipairs(p.Character:GetDescendants()) do
                if d:IsA("BasePart") then d.Anchored = s end
            end
        end
    end
end
local function invisAll(s)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _, d in ipairs(p.Character:GetDescendants()) do
                if d:IsA("BasePart") then d.Transparency = s and 1 or 0 end
                if d:IsA("Decal") then d.Transparency = s and 1 or 0 end
            end
        end
    end
end
local function nuke()
    local c = LP.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    for i = 1, 20 do
        local p = Instance.new("Part", WS)
        p.Size = Vector3.new(3, 3, 3)
        p.Position = c.HumanoidRootPart.Position + Vector3.new(math.random(-40,40), 50, math.random(-40,40))
        p.BrickColor = BrickColor.new("Really red")
        task.delay(2 + i*0.1, function()
            local e = Instance.new("Explosion", WS)
            e.Position = p.Position; e.BlastRadius = 20; p:Destroy()
        end)
    end
end
local function bombRain()
    local c = LP.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    for i = 1, 20 do
        local p = Instance.new("Part", WS)
        p.Size = Vector3.new(2, 2, 2)
        p.Position = c.HumanoidRootPart.Position + Vector3.new(math.random(-40,40), 60, math.random(-40,40))
        p.BrickColor = BrickColor.new("Really red")
        task.delay(3, function()
            local e = Instance.new("Explosion", WS)
            e.Position = p.Position; e.BlastRadius = 15; p:Destroy()
        end)
    end
end
local function flingAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Velocity = Vector3.new(9e9, 9e9, 9e9) end
        end
    end
end

