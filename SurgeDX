-- FETCH LATEST FROM GITHUB (v60x repo)
--==================================================================
local function fetchLatestIDs()
    local urls = {
        "https://raw.githubusercontent.com/v60x/Roblox-Require-Scripts/main/scripts.lua",
        "https://raw.githubusercontent.com/v60x/Roblox-Require-Scripts/main/README.md",
        "https://raw.githubusercontent.com/v60x/Roblox-Require-Scripts/master/scripts.lua",
        "https://raw.githubusercontent.com/v60x/Roblox-Require-Scripts/main/list.txt",
    }
    for _, url in ipairs(urls) do
        local ok, src = pcall(function() return game:HttpGet(url) end)
        if ok and src and #src > 30 then
            -- Parse lines like: require(1234567890) or require(1234567890).method()
            local count = 0
            for id in src:gmatch("require%s*%(%s*(%d+)%s*%)") do
                local idNum = tonumber(id)
                if idNum and not KNOWN_SS_MODULES["Fetched "..id] then
                    KNOWN_SS_MODULES["Fetched "..id] = { id = idNum, args = {} }
                    count = count + 1
                end
            end
            if count > 0 then
                print("[SS] Fetched "..count.." new IDs from "..url)
                return count
            end
        end
    end
    print("[SS] No IDs fetched from GitHub")
    return 0
end

