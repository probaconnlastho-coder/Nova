local function getParent()
    local ok, h = pcall(function()
        local fn = rawget(_G, "gethui")
        if type(fn) == "function" then return fn() end
    end)
    if ok and h and typeof(h) == "Instance" then return h end
    return CoreGuiSvc or LP:WaitForChild("PlayerGui", 5)
end
local parent = getParent()
for _, n in ipairs({"HappyHub","HappyHubUI","po","main","icon"}) do
    for _, cont in ipairs({parent, CoreGuiSvc, LP:FindFirstChildOfClass("PlayerGui"), WS}) do
        if cont then
            local o = cont:FindFirstChild(n)
            if o then pcall(function() o:Destroy() end) end
        end
    end
end

