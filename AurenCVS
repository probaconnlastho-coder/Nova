local function makeMelee(name, size, color, dmg)
	local c = getChar()
	local tool = safe("Tool", {Name = name, RequiresHandle = true}, c)
	local handle = safe("Part", {Name = "Handle", Size = size, BrickColor = BrickColor.new(color), CanCollide = false}, tool)
	tool.GripPos = Vector3.new(0, -1, 0)
	tool.Activated:Connect(function()
		local hrp = getHRP()
		if not hrp then return end
		local s = safe("Sound", {SoundId = "rbxassetid://12222216", Volume = 1}, handle) s:Play() Debris:AddItem(s, 1)
		local hit = safe("Part", {Size = Vector3.new(4, 4, 4), CFrame = hrp.CFrame * CFrame.new(0, 0, -4), Transparency = 1, CanCollide = false, Name = "HH_Hit"}, workspace)
		Debris:AddItem(hit, 0.1)
		hit.Touched:Connect(function(o)
			local m = o.Parent:FindFirstChildOfClass("Humanoid")
			if m and o.Parent ~= c then m:TakeDamage(dmg or 25) end
		end)
	end)
	notify(name)
end

local function makeGun(name, size, color, dmg)
	local c = getChar()
	local tool = safe("Tool", {Name = name}, c)
	local handle = safe("Part", {Name = "Handle", Size = size, BrickColor = BrickColor.new(color), CanCollide = false}, tool)
	tool.GripPos = Vector3.new(0, -0.5, -1)
	tool.Activated:Connect(function()
		local hrp = getHRP()
		if not hrp then return end
		local s = safe("Sound", {SoundId = "rbxassetid://1113117129", Volume = 1}, handle) s:Play() Debris:AddItem(s, 1)
		local ray = Ray.new(handle.Position, Cam.CFrame.LookVector * 500)
		local hit, pos = workspace:FindPartOnRay(ray, c)
		if hit then
			local m = hit.Parent:FindFirstChildOfClass("Humanoid")
			if m and hit.Parent ~= c then m:TakeDamage(dmg or 35) end
			safe("Explosion", {Position = pos, BlastRadius = 1, BlastPressure = 0, DestroyJointRadiusPercent = 0}, workspace)
		end
	end)
	notify(name)
end

