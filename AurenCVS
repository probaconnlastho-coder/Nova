-- ============ COMMAND BAR ============
cmdInput.FocusLost:Connect(function(enterPressed)
	if enterPressed and cmdInput.Text ~= "" and cmdInput.Text ~= "Here Enter Commands." then
		local cmd = cmdInput.Text:lower()
		cmdInput.Text = ""
		if cmd == "cmds" or cmd == "help" then
			notify("rejoin, speed, jump, god, ungod, heal, r6, dex, fly, reset, morph, spawn")
		elseif cmd == "rejoin" then rejoin()
		elseif cmd:match("^speed (%d+)$") then setSpeed(tonumber(cmd:match("^speed (%d+)$")))
		elseif cmd:match("^jump (%d+)$") then setJump(tonumber(cmd:match("^jump (%d+)$")))
		elseif cmd:match("^morph (.+)$") then morphName(cmd:match("^morph (.+)$"))
		elseif cmd:match("^spawn (.+)$") then spawnNPC(cmd:match("^spawn (.+)$"), 1)
		elseif cmd == "god" then god()
		elseif cmd == "ungod" then ungod()
		elseif cmd == "heal" then heal()
		elseif cmd == "r6" then forceR6()
		elseif cmd == "dex" then openDEX()
		elseif cmd == "fly" then toggleFly()
		elseif cmd == "reset" then getChar():BreakJoints()
		else notify("Unknown: " .. cmd) end
	end
end)

-- ============ DRAGGING ============
local dragging, dragStart, dragPos
titleLabel.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = true dragStart = i.Position dragPos = kabum.Position
	end
end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		local d = i.Position - dragStart
		kabum.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + d.X, dragPos.Y.Scale, dragPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

