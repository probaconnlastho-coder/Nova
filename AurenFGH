		if c:IsA("TextButton") and c.Name == "__p" then c:Destroy() end
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP then
			local btn = makeBtn(Pages.playerr, pl.Name .. " (" .. pl.UserId .. ")", function()
				local target = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
				local hrp = getHRP()
				if target and hrp then
					hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
				end
			end)
			btn.Name = "__p"
		end
	end
end
makeBtn(Pages.playerr, "Refresh", refreshPlayers)
refreshPlayers()

