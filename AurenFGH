local function forceR6()
	pcall(function()
		local c = getChar()
		for _, v in pairs(c:GetDescendants()) do
			if v:IsA("BasePart") then v:BreakJoints() end
		end
		c:ClearAllChildren()
		LP.CharacterAutoLoads = false
		local newChar = Players:CreateHumanoidModelFromUserId(LP.UserId)
		newChar.Name = LP.Name
		newChar.Parent = workspace
		LP.Character = newChar
	end)
end

