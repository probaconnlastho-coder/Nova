local flying, flyBV, flyBG
local function toggleFly()
	flying = not flying
	if flying then
		local hrp = getHRP(); if not hrp then return end
		flyBV = safe("BodyVelocity", {MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.new()}, hrp)
		flyBG = safe("BodyGyro", {MaxTorque = Vector3.new(1e5, 1e5, 1e5), P = 1000, CFrame = hrp.CFrame}, hrp)
	else
		if flyBV then flyBV:Destroy() end
		if flyBG then flyBG:Destroy() end
	end
end
Run.RenderStepped:Connect(function()
	if flying and flyBV and flyBG then
		local cf = Cam.CFrame
		local m = Vector3.new()
		if UIS:IsKeyDown(Enum.KeyCode.W) then m = m + cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then m = m - cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then m = m - cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then m = m + cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then m = m + Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then m = m - Vector3.new(0, 1, 0) end
		flyBV.Velocity = m * 60
		flyBG.CFrame = cf
	end
end)

local function spawnDummy()
	local hrp = getHRP(); if not hrp then return end
	local d = safe("Model", {Name = "HappyHub_Dummy"}, workspace)
	local base = hrp.CFrame * CFrame.new(0, 0, -6)
	local parts = {}
	for _, x in ipairs({
		{"HumanoidRootPart", Vector3.new(2,2,1), Vector3.new(0,0,0), true},
		{"Torso", Vector3.new(2,2,1), Vector3.new(0,0,0)},
		{"Head", Vector3.new(2,1,1), Vector3.new(0,1.5,0)},
		{"Left Arm", Vector3.new(1,2,1), Vector3.new(-1.5,0,0)},
		{"Right Arm", Vector3.new(1,2,1), Vector3.new(1.5,0,0)},
		{"Left Leg", Vector3.new(1,2,1), Vector3.new(-0.5,-2,0)},
		{"Right Leg", Vector3.new(1,2,1), Vector3.new(0.5,-2,0)}
	}) do
		local p = safe("Part", {Name = x[1], Size = x[2], CFrame = base * CFrame.new(x[3]), Anchored = x[4] or false, BrickColor = BrickColor.new("Really blue")}, d)
		if x[1] == "Head" then
			safe("SpecialMesh", {Scale = Vector3.new(1.25, 1.25, 1.25)}, p)
			safe("Decal", {Name = "Face"}, p)
		end
		if x[1] == "HumanoidRootPart" then p.Transparency = 0.5 end
		table.insert(parts, p)
	end
	safe("Humanoid", {}, d)
	for _, p in ipairs(parts) do
		if p.Name ~= "HumanoidRootPart" then
			local w = safe("WeldConstraint", {}, p)
			w.Part0 = parts[1] w.Part1 = p
		end
	end
end

