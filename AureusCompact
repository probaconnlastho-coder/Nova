local function pushLocalLog(entry)
table.insert(Aureus.LocalLog,entry)
local color=(entry.level=="error"and C.Error)or(entry.level=="warn"and C.Warning)or(entry.level=="success"and C.Success)or C.Text
Create("TextLabel",{Size=UDim2.new(1,-4,0,16),BackgroundTransparency=1,Text=("[%s] %s"):format(entry.level,entry.msg),TextColor3=color,Font=Aureus.Config.FontCode,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,Parent=LocalConsole})
local count=0
for _,c in ipairs(LocalConsole:GetChildren())do if c:IsA("TextLabel")then count=count+1 end end
LocalConsole.CanvasSize=UDim2.new(0,0,0,count*18)
LocalConsole.CanvasPosition=Vector2.new(0,LocalConsole.CanvasSize.Y.Offset)
end
Aureus.UI=Aureus.UI or{}
