local function MakeSlider(parent,y,label,key,min,max,step)
local row=Create("Frame",{Size=UDim2.new(1,-30,0,44),Position=UDim2.new(0,15,0,y),BackgroundColor3=C.Background,BorderSizePixel=0,Parent=parent})
Create("UICorner",{CornerRadius=UDim.new(0,6),Parent=row})
Create("UIStroke",{Color=C.Border,Thickness=1,Parent=row})
local val=Create("TextLabel",{Size=UDim2.new(1,-24,0,16),Position=UDim2.new(0,12,0,4),BackgroundTransparency=1,Text=("%s: %s"):format(label,tostring(Aureus.Settings[key])),TextColor3=C.Text,Font=Aureus.Config.FontRegular,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
local bar=Create("Frame",{Size=UDim2.new(1,-24,0,6),Position=UDim2.new(0,12,0,28),BackgroundColor3=C.Background,BorderSizePixel=0,Parent=row})
Create("UICorner",{CornerRadius=UDim.new(0,3),Parent=bar})
local fill=Create("Frame",{Size=UDim2.new((Aureus.Settings[key]-min)/(max-min),0,1,0),BackgroundColor3=C.Accent,BorderSizePixel=0,Parent=bar})
Create("UICorner",{CornerRadius=UDim.new(0,3),Parent=fill})
local hit=Create("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",Parent=bar})
hit.MouseButton1Down:Connect(function()
local moving=true
local conn
conn=UserInputService.InputChanged:Connect(function(i)
if not moving then return end
if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
local rel=(i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X
rel=math.clamp(rel,0,1)
local v=math.floor((min+rel*(max-min))/step+0.5)*step
Aureus.Settings[key]=v
fill.Size=UDim2.new((v-min)/(max-min),0,1,0)
val.Text=("%s: %s"):format(label,tostring(v))
end)
local up
up=UserInputService.InputEnded:Connect(function()
moving=false;conn:Disconnect();up:Disconnect()
end)
end)
end
