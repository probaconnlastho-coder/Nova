Create("TextLabel",{Size=UDim2.new(1,-20,0,12),Position=UDim2.new(0,10,0,24),BackgroundTransparency=1,Text="format: "..hit.format.."   •   "..hit.at,TextColor3=C.Success,Font=Aureus.Config.FontCode,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
Create("TextLabel",{Size=UDim2.new(1,-20,0,12),Position=UDim2.new(0,10,0,38),BackgroundTransparency=1,Text=shortPath(hit.path),TextColor3=C.SubText,Font=Aureus.Config.FontCode,TextSize=9,TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
row.MouseButton1Click:Connect(function()
Aureus.selectedHit=hit
Aureus:refreshHitUI()
Aureus:Notify("Selected","Using backdoor #"..i.." ("..hit.format..")",2,"info")
end)
y=y+64
end
HitList.CanvasSize=UDim2.new(0,0,0,y)
end
