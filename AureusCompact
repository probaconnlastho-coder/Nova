EmptyHitsLabel.Visible=#self.Hits==0
local y=0
for i,hit in ipairs(self.Hits)do
local row=Create("TextButton",{Size=UDim2.new(1,-8,0,58),Position=UDim2.new(0,0,0,y),BackgroundColor3=(self.selectedHit==hit)and C.CardHover or C.Background,Text="",BorderSizePixel=0,Parent=HitList})
Create("UICorner",{CornerRadius=UDim.new(0,6),Parent=row})
