function Aureus:analyzeDanger(src,meta)
if not src or src==""then return "Unknown",0,{"No source available"}end
local flags,score={},0
local requireCount=0
for _ in string.gmatch(src,"require%s*%(")do requireCount=requireCount+1 end
if requireCount>0 then score=score+25 table.insert(flags,("Uses require() x%d — loads external code"):format(requireCount))end
if string.find(src,"loadstring%s*%(")then score=score+20 table.insert(flags,"Uses loadstring() — dynamic code execution")end
if string.find(src,"[^%w]load%s*%(")then score=score+15 table.insert(flags,"Uses load() — dynamic chunk loading")end
if string.find(src,"getfenv")or string.find(src,"setfenv")then score=score+20 table.insert(flags,"Uses getfenv/setfenv — environment manipulation")end
local httpCount=0
for _ in string.gmatch(src,"HttpGet%s*%(")do httpCount=httpCount+1 end
for _ in string.gmatch(src,"HttpPost%s*%(")do httpCount=httpCount+1 end
for _ in string.gmatch(src,"request%s*%(")do httpCount=httpCount+1 end
if httpCount>0 then score=score+15 table.insert(flags,("Uses HTTP x%d — network access"):format(httpCount))end
local obfPatterns={"string%.char%s*%(%s*%d+%s*,%s*%d+%s*,%s*%d+","\\x%x%x\\x%x%x\\x%x%x","table%.concat%s*%(%s*{%s*%d+%s*,%s*%d+","for%s+%w+%s*=%s*%d+%s*,%s*#%w+%s+do%s+%w+%s*=%s*%w+%s*%.%.%s*"}
local obfMatches=0
for _,pat in ipairs(obfPatterns)do if string.find(src,pat)then obfMatches=obfMatches+1 end end
if obfMatches>=2 then score=score+30 table.insert(flags,"Heavy obfuscation detected — code is intentionally hidden")
elseif obfMatches==1 then score=score+10 table.insert(flags,"Possible obfuscation — some code is encoded")end
if meta and meta.key then score=score+5 table.insert(flags,"Requires a key system")end
if meta and meta.isPatched then score=score+5 table.insert(flags,"Marked as patched")end
if #flags==0 then table.insert(flags,"No suspicious patterns detected in source")end
local level
if score>=60 then level="Critical"
elseif score>=40 then level="High"
elseif score>=20 then level="Medium"
elseif score>0 then level="Low"
else level="Safe"end
return level,score,flags
end
