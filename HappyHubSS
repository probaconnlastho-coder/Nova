local function RunCmd(input)
    local args = {}
    for w in input:gmatch("%S+") do table.insert(args, w) end
    local cmd = (args[1] or ""):lower()
    if cmd == "cmds" then cmdListFrame.Visible = not cmdListFrame.Visible; return "Toggled"
    elseif cmd == "mr.bean" or cmd == "mrbean" then pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))() end); return "Mr Bean loading"
    elseif cmd == "n0ot" then for _, p in ipairs(Players:GetPlayers()) do if p.Character then local hrp = p.Character:FindFirstChild("HumanoidRootPart"); if hrp then hrp.Velocity = Vector3.new(0, 9999, 0) end end end; return "n0ot executed"
    elseif cmd == "fumo" then return "Fumo requested"
    elseif cmd == "neb" then pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))() end); return "Neb starting"
    elseif cmd == "shutdown" then return "Requires server access"
    elseif cmd == "r6" then for _, p in ipairs(Players:GetPlayers()) do if p.Character then local h = p.Character:FindFirstChildOfClass("Humanoid"); if h then h:ChangeState(Enum.HumanoidStateType.Dead) end end end; return "R6 forced"
    elseif cmd == "fly" then return "Fly enabled (hold space)"
    elseif cmd == "noclip" then local ch = LP.Character; if ch then for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end; return "Noclip on"
    elseif cmd == "speed" then local v = tonumber(args[2]); if v then local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed = v end return "Speed " .. v end return "Usage: Speed <n>"
    elseif cmd == "jump" then local v = tonumber(args[2]); if v then local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.JumpPower = v end return "Jump " .. v end return "Usage: Jump <n>"
    elseif cmd == "kill" and (args[2] or ""):lower() == "all" then for _, p in ipairs(Players:GetPlayers()) do if p ~= LP and p.Character then local h = p.Character:FindFirstChildOfClass("Humanoid"); if h then h.Health = 0 end end end return "Killed all"
    elseif cmd == "freeze" and (args[2] or ""):lower() == "all" then for _, p in ipairs(Players:GetPlayers()) do if p ~= LP and p.Character then local h = p.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed = 0; h.JumpPower = 0 end end end return "Froze all"
