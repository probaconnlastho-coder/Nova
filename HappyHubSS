            if hrp then local m = N("Model", { Name = "Dummy" }, workspace); local t = N("Part", { Size = Vector3.new(2, 2, 1), Position = hrp.Position + hrp.CFrame.LookVector * 6 }, m); N("Humanoid", {}, m); m.PrimaryPart = t end
        end
        Notify("Quick", d[1])
    end)
end

