local function entEffect(name)
    local ch = LP.Character; local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position
    local lower = name:lower()
    if lower:find("nuke") then
        local nuke = N("Part", { Size = Vector3.new(20, 20, 20), Position = pos + Vector3.new(0, 200, 0),
            Color = Color3.fromRGB(255, 100, 0), Material = Enum.Material.Neon }, workspace)
        task.spawn(function() for _ = 1, 30 do if not nuke.Parent then break end nuke.CFrame = nuke.CFrame - Vector3.new(0, 5, 0); task.wait(0.05) end
            N("Explosion", { Position = nuke.Position, BlastRadius = 60, DestroyJointRadiusPercent = 0 }, workspace); nuke:Destroy() end)
    elseif lower:find("tornado") then
        for i = 1, 20 do task.spawn(function()
            local p = N("Part", { Size = Vector3.new(3, 3, 3), Position = pos + Vector3.new(math.random(-20, 20), i * 5, math.random(-20, 20)),
                Color = Color3.fromRGB(150, 150, 150) }, workspace)
            task.delay(8, function() if p then p:Destroy() end end) end) end
    elseif lower:find("meteor") then
        for _ = 1, 15 do task.spawn(function()
            local m = N("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4),
                Position = Vector3.new(math.random(-80, 80), 150, math.random(-80, 80)),
                Color = Color3.fromRGB(150, 50, 0), Material = Enum.Material.Neon }, workspace)
            task.delay(6, function() if m and m.Parent then
                N("Explosion", { Position = m.Position, BlastRadius = 10 }, workspace); m:Destroy() end end) end) end
    elseif lower:find("lava") then
        N("Part", { Size = Vector3.new(200, 2, 200), Position = Vector3.new(pos.X, pos.Y - 3, pos.Z),
            Color = Color3.fromRGB(255, 60, 0), Material = Enum.Material.Neon, Anchored = true }, workspace)
    elseif lower:find("tsunami") then
        N("Part", { Size = Vector3.new(200, 40, 20), Position = pos + Vector3.new(0, 5, -100),
            Color = Color3.fromRGB(0, 100, 255), Material = Enum.Material.Water, Anchored = true }, workspace)
    elseif lower:find("earthquake") then
        task.spawn(function() for _ = 1, 60 do workspace.Gravity = 196.2 + math.random(-80, 80); task.wait(0.05) end workspace.Gravity = 196.2 end)
    elseif lower:find("blind") then
        local b = N("ColorCorrectionEffect", { Brightness = -1, Contrast = 1, Saturation = -1 }, Lighting)
        task.delay(5, function() if b then b:Destroy() end end)
    elseif lower:find("thunder") then
        Lighting.Ambient = Color3.fromRGB(40, 40, 60)
        task.spawn(function() for _ = 1, 10 do Lighting.Brightness = 5; task.wait(0.05); Lighting.Brightness = 1; task.wait(math.random(1, 3)) end end)
    elseif lower:find("rickroll") then
        if currentSound then currentSound:Destroy() end
        currentSound = N("Sound", { SoundId = "rbxassetid://1837879082", Volume = 2 }, SoundService); currentSound:Play()
    elseif lower:find("arrest") then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid"); if h then h.Sit = true end end end
    elseif lower:find("pee") then
        for _ = 1, 30 do task.spawn(function()
            local p = N("Part", { Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1),
                Position = pos + Vector3.new(math.random(-10, 10), 5, math.random(-10, 10)),
                Color = Color3.fromRGB(255, 255, 100) }, workspace)
            task.delay(5, function() if p then p:Destroy() end end) end) end
    elseif lower:find("spawn") then
        for _ = 1, 5 do task.spawn(function()
            local m = N("Model", { Name = "Noob" }, workspace)
            local t = N("Part", { Size = Vector3.new(2, 2, 1), Position = pos + Vector3.new(math.random(-15, 15), 5, math.random(-15, 15)),
                Color = Color3.fromRGB(255, 255, 0) }, m)
            N("Humanoid", {}, m); m.PrimaryPart = t end) end
    end
    Notify("ENT", name)
end
