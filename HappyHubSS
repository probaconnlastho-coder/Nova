--==== HELPERS ====
local function N(c, p, par)
    local i = Instance.new(c)
    if p then for k, v in pairs(p) do i[k] = v end end
    if par then i.Parent = par end
    return i
end
local function C(p, r) return N("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p) end
local function G(p) return N("UIGradient", {}, p) end
local function S(p, id) return N("Sound", { SoundId = id or "rbxassetid://1673280232", Volume = 0.5 }, p) end
local function Notify(t, x) pcall(function() StarterGui:SetCore("SendNotification", { Title = t, Text = x, Duration = 5 }) end) end
local function MB(par, txt, pos, size)
    local b = N("TextButton", {
        Size = size or UDim2.new(0, 94, 0, 40), Position = pos or UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0,
        Text = txt, TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 14, Font = Enum.Font.SourceSans, TextScaled = true, TextWrapped = true,
    }, par)
    C(b, 6); S(b)
    return b
end
local function ML(par, txt, pos, size, col)
    return N("TextLabel", {
        Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0,
        Text = txt, TextColor3 = col or Color3.fromRGB(255, 255, 255),
        TextSize = 14, Font = Enum.Font.SourceSans, TextScaled = true, TextWrapped = true,
    }, par)
end
local function MC(par)
    return N("ScrollingFrame", {
        Size = UDim2.new(0, 554, 0, 284), Position = UDim2.new(0, 0, 0.004, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
        ScrollBarThickness = 8, CanvasSize = UDim2.new(0, 0, 8, 0),
    }, par)
end
local function MG(par, cell)
    return N("UIGridLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder, CellPadding = UDim2.new(0, 8, 0, 4),
        CellSize = cell or UDim2.new(0, 94, 0, 40),
    }, par)
end
local function GetTarget(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #name) == name:lower() then return p end
    end
end

