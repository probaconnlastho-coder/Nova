        Name              = "CommandBar",
        Size              = UDim2.new(1, -12, 0, 26),
        Position          = UDim2.new(0, 6, 1, 2),
        BackgroundColor3  = Color3.fromRGB(15, 15, 20),
        BorderColor3      = Color3.fromRGB(60, 60, 80),
        BorderSizePixel   = 1,
        ZIndex            = 5,
    }, Main)
    corner(cmdFrame, 5)

    local cmdInput = make("TextBox", {
        Size              = UDim2.new(1, -10, 1, 0),
        Position          = UDim2.new(0, 5, 0, 0),
        BackgroundTransparency = 1,
        Text              = "",
        PlaceholderText   = "Enter commands...",
        PlaceholderColor3 = Color3.fromRGB(140, 140, 160),
        TextColor3        = Color3.fromRGB(230, 230, 240),
        TextSize          = 13,
        Font              = Enum.Font.Gotham,
        TextXAlignment    = Enum.TextXAlignment.Left,
        ClearTextOnFocus  = false,
        ZIndex            = 6,
    }, cmdFrame)

    cmdInput.FocusLost:Connect(function(enter)
        if not enter then return end
        local t = string.lower(cmdInput.Text)
        if _G.__happyhub_out then
            _G.__happyhub_out.Text = _G.__happyhub_out.Text .. "[CMD] " .. t .. "\n"
        end
        if t == "cmds" then
            notify("cmds: cmds, ff, god, noclip, fumo, neb, mr.bean, shutdown", 4)
        elseif t == "ff" then
            pcall(function()
                for _, d in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = false end
                end
            end)
            notify("FF on")
        elseif t == "god" then
            pcall(function()
                local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if h then h.MaxHealth = math.huge; h.Health = math.huge end
            end)
            notify("God on")
        elseif t == "noclip" then
            pcall(function()
                for _, d in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = false end
                end
            end)
            notify("Noclip")
        elseif t == "fumo" then
            giveTool("Fumo")
            notify("Fumo tool given")
        elseif t == "neb" then
            notify("Neb Anti-Abuse launched")
        elseif t == "mr.bean" then
            notify("Mr.Bean toggled")
        elseif t == "shutdown" then
            notify("Shutdown requested")
        else
            notify("Unknown command: " .. t)
        end
        cmdInput.Text = ""
    end)
end

--== Step 45: Set FPS/Ping updates ==
do
    local frames = 0
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        elapsed = elapsed + dt
        if elapsed >= 1 then
            pcall(function()
                FPSLabel.Text = "FPS: " .. frames
            end)
            frames = 0
            elapsed = 0
        end
    end)
    task.spawn(function()
        while task.wait(1) do
            pcall(function()
                local ok, p = pcall(function()
                    return math.floor(LocalPlayer:GetNetworkPing() * 1000)
                end)
                PingLabel.Text = "Ping: " .. (ok and p or 0) .. "ms"
            end)
        end
    end)
end

