local function fireRemote(name)
    local ok = pcall(function()
        local re = Instance.new("RemoteEvent")
        re.Name = "HappyHub_" .. name
        re.Parent = ScreenGui
        re:FireServer()
        task.delay(0.1, function() pcall(function() re:Destroy() end) end)
    end)
    return ok
end

local function setSky(id)
    pcall(function()
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if not sky then
            sky = Instance.new("Sky", Lighting)
        end
        sky.SkyboxBk = id
        sky.SkyboxDn = id
        sky.SkyboxFt = id
        sky.SkyboxLf = id
        sky.SkyboxRt = id
        sky.SkyboxUp = id
    end)
end

local function setFace(id)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Decal") and (d.Name == "face" or d.Name == "Face") then
                d.Texture = id
            end
        end
    end)
end

local function jumpscare(id, time)
    time = time or 2
    local g = make("ImageLabel", {
        Size              = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Image             = id,
        ImageTransparency = 0,
        ZIndex            = 500,
        ScaleType         = Enum.ScaleType.Fit,
    }, ScreenGui)
    pcall(function()
        local s = Instance.new("Sound", g)
        s.SoundId = "rbxassetid://574998869"
        s.Volume = 3
        s:Play()
    end)
    task.delay(time, function()
        pcall(function() g:Destroy() end)
    end)
end

local function particles(id)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if not root then return end
        local att = Instance.new("Attachment", root)
        local p = Instance.new("ParticleEmitter", att)
        p.Texture = tostring(id)
        p.Rate = 50
        p.Lifetime = NumberRange.new(1, 2)
        p.Speed = NumberRange.new(5, 10)
        task.delay(5, function()
            pcall(function() p:Destroy(); att:Destroy() end)
        end)
    end)
end

local function spawnDummy()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if not hrp then return end
        local model = Instance.new("Model", Workspace)
        model.Name = "HappyHubDummy"
        local hum = Instance.new("Humanoid", model)
        local torso = Instance.new("Part", model)
        torso.Name = "Torso"
        torso.Size = Vector3.new(2, 2, 1)
        torso.CFrame = hrp.CFrame * CFrame.new(0, 0, -6)
        torso.BrickColor = BrickColor.new("Bright yellow")
        local head = Instance.new("Part", model)
        head.Name = "Head"
        head.Size = Vector3.new(2, 1, 1)
        head.CFrame = torso.CFrame * CFrame.new(0, 1.5, 0)
        head.BrickColor = BrickColor.new("Bright yellow")
        local face = Instance.new("Decal", head)
        face.Texture = "rbxasset://textures/face.png"
        face.Name = "Face"
        for _, part in ipairs({"Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
            local p = Instance.new("Part", model)
            p.Name = part
            p.Size = Vector3.new(1, 2, 1)
            p.CFrame = torso.CFrame
            p.BrickColor = BrickColor.new("Bright yellow")
        end
    end)
end

local function giveTool(name)
    pcall(function()
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if not backpack then
            backpack = Instance.new("Backpack", LocalPlayer)
        end
        local tool = Instance.new("Tool", backpack)
        tool.Name = name or "HappyTool"
        tool.CanBeDropped = false
        local handle = Instance.new("Part", tool)
