--== Step 2: Universal parent finder with 5 fallbacks ==
local function getParent()
    -- 1. gethui (Synapse, Script-Ware, Krnl, Fluxus, Delta)
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui and typeof(hui) == "Instance" then
        return hui
    end
    -- 2. CoreGui (most executors)
    local ok2 = pcall(function()
        if CoreGui and CoreGui:IsA("BasePlayerGui") then return true end
    end)
    if ok2 and CoreGui then
        return CoreGui
    end
    -- 3. LocalPlayer.PlayerGui
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then return pg end
    -- 4. Wait for PlayerGui
    local ok3, pg2 = pcall(function()
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end)
    if ok3 and pg2 then return pg2 end
    -- 5. Last resort: Workspace (visible but unusual)
    return Workspace
end

--== Step 3: Clean previous instance ==
local parent = getParent()
for _, name in ipairs({"HappyHub", "HappyHubUI", "po"}) do
    local old = parent:FindFirstChild(name)
