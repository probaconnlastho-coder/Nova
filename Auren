    local passIn = New("TextBox", { Size = UDim2.new(0, 200, 0, 17), Position = UDim2.new(0.024, 0, 0.722, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 3, Text = "", TextColor3 = Color3.fromRGB(255, 255, 255),
        TextScaled = true, Font = Enum.Font.SourceSans }, loginF)
    local hintLbl = ML(loginF, "Password - SS", UDim2.new(0.72, 0, 0.46, 0), UDim2.new(0, 285, 0, 35))
    hintLbl.Rotation = -90
    local enterBtn = New("TextButton", { Size = UDim2.new(0, 161, 0, 18), Position = UDim2.new(0.05, 0, 0.886, 0),
