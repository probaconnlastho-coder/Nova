        BorderSizePixel = 2, Text = "Enter", TextColor3 = Color3.fromRGB(255, 255, 255),
        TextScaled = true, Font = Enum.Font.SourceSans }, loginF)
    enterBtn.MouseButton1Click:Connect(function()
        if passIn.Text == "SS" then
            loginF.Visible = false
            LeftBar.Visible = true
            RightBar.Visible = true
            ShowTab("home")
            Notify("HappyHub", "Login successful")
        else
            passIn.Text = ""
            Notify("HappyHub", "Wrong password")
        end
    end)
    passIn.FocusLost:Connect(function(enter) if enter then enterBtn:Activate() end end)
