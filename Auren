                Color = Color3.fromRGB(255, 100, 0), Material = Enum.Material.Neon }, workspace)
            task.spawn(function()
                for _ = 1, 30 do
                    if not nuke.Parent then break end
                    nuke.CFrame = nuke.CFrame - Vector3.new(0, 5, 0)
                    task.wait(0.05)
                end
                pcall(function() New("Explosion", { Position = nuke.Position, BlastRadius = 60, DestroyJointRadiusPercent = 0 }, workspace) end)
                nuke:Destroy()
            end)
        elseif lower:find("tornado") then
            for i = 1, 20 do task.spawn(function()
                local p = New("Part", { Size = Vector3.new(3, 3, 3),
                    Position = pos + Vector3.new(math.random(-20, 20), i * 5, math.random(-20, 20)),
                    Color = Color3.fromRGB(150, 150, 150) }, workspace)
                task.delay(8, function() if p then p:Destroy() end end)
            end) end
        elseif lower:find("meteor") then
            for _ = 1, 15 do task.spawn(function()
