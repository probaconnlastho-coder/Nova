                    Position = Vector3.new(math.random(-80, 80), 150, math.random(-80, 80)),
                    Color = Color3.fromRGB(150, 50, 0), Material = Enum.Material.Neon }, workspace)
                task.delay(6, function()
                    if m and m.Parent then
                        pcall(function() New("Explosion", { Position = m.Position, BlastRadius = 10 }, workspace) end)
                        m:Destroy()
                    end
                end)
            end) end
