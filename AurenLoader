		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, ZIndex = 10,
	})

	local filterRow = new("Frame", {
		Parent = hubMain, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		LayoutOrder = 2, ZIndex = 8,
	})
	new("UIListLayout", {
		Parent = filterRow, FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local filters = { key = nil, universal = nil, verified = nil }
	local filterButtons = {}
	local function makeFilterButton(label, key, value)
		local fbtn = new("TextButton", {
			Parent = filterRow, Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.3,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 9,
		})
		round(fbtn, 7)
		padding(fbtn, 0, 10, 0, 10)
		new("TextLabel", {
			Parent = fbtn, Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Text = label, Font = Theme.FontMedium, TextSize = 10,
			TextColor3 = Theme.SubText, ZIndex = 10,
		})
		table.insert(filterButtons, { btn = fbtn, key = key, value = value })
		fbtn.MouseButton1Click:Connect(function()
			if filters[key] == value then
				filters[key] = nil
				tween(fbtn, 0.2, { BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.3 })
			else
				filters[key] = value
				tween(fbtn, 0.2, { BackgroundColor3 = Window.Accent, BackgroundTransparency = 0.15 })
			end
		end)
	end
	makeFilterButton("Keyless", "key", 0)
	makeFilterButton("Key", "key", 1)
	makeFilterButton("Verified", "verified", 1)
	makeFilterButton("Universal", "universal", 1)

	local scriptList = new("Frame", {
