			BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 102,
		})
		new("UIListLayout", {
			Parent = badgeRow, FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
