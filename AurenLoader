	local debounce = false
	local function runSearch()
		if debounce then return end
		debounce = true
		task.delay(0.5, function() debounce = false end)
		for _, ch in ipairs(scriptList:GetChildren()) do
			if ch:IsA("Frame") then ch:Destroy() end
		end
		local q = searchInput.Text
		local active = {}
		if filters.key ~= nil then active.key = filters.key end
		if filters.universal ~= nil then active.universal = filters.universal end
		if filters.verified ~= nil then active.verified = filters.verified end
		if q == "" and next(active) == nil then
			statusLbl.Text = "Type a search or tap a filter to begin."
			return
		end
		statusLbl.Text = "Searching…"
		local scripts = fetchScripts(q, active)
		if #scripts == 0 then
			statusLbl.Text = "No scripts found. Try a different search."
			return
		end
		statusLbl.Text = "Found " .. tostring(#scripts) .. " scripts"
		for _, sd in ipairs(scripts) do createEntry(sd) end
	end
	searchInput.FocusLost:Connect(function(enter)
		if enter then runSearch() end
	end)
	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		task.delay(0.8, function()
			if searchInput.Text ~= "" then runSearch() end
		end)
	end)
	for _, fb in ipairs(filterButtons) do
		fb.btn.MouseButton1Click:Connect(function() task.delay(0.1, runSearch) end)
	end

