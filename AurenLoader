  Auren Hub Addon  •  v1.1
  Usage:
    local Auren = loadstring(game:HttpGet(".../Auren%20v4.1"))()
    local Hub   = loadstring(game:HttpGet(".../AurenHub"))()(Auren)
════════════════════════════════════════════════════════════════════
]]

return function(Auren)
	if not Auren or type(Auren) ~= "table" or not Auren.CreateWindow then
		warn("[AurenHub] Invalid Auren library received.")
		return nil
	end

	local HttpService      = game:GetService("HttpService")
	local UserInputService = game:GetService("UserInputService")
	local TweenService     = game:GetService("TweenService")

	local httpRequest  = (syn and syn.request) or http_request or request
		or (http and http.request) or (fluxus and fluxus.request)
	local setClipboard = setclipboard or toclipboard or set_clipboard
		or (syn and syn.write_clipboard)

	local Theme = Auren.Theme

	local function new(class, props)
		local inst = Instance.new(class)
		local parent
		for k, v in pairs(props or {}) do
			if k == "Parent" then parent = v else inst[k] = v end
		end
		if parent then inst.Parent = parent end
		return inst
	end
	local function round(inst, radius)
		local c = Instance.new("UICorner")
		c.CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius)
		c.Parent = inst
		return c
	end
	local function stroke(inst, color, thickness, transparency)
		local s = Instance.new("UIStroke")
		s.Color = color or Color3.new(1, 1, 1)
		s.Thickness = thickness or 1
		s.Transparency = transparency or 0.85
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = inst
		return s
	end
	local function padding(inst, t, r, b, l)
		local p = Instance.new("UIPadding")
		p.PaddingTop, p.PaddingRight = UDim.new(0, t or 0), UDim.new(0, r or 0)
		p.PaddingBottom, p.PaddingLeft = UDim.new(0, b or 0), UDim.new(0, l or 0)
		p.Parent = inst
		return p
	end
	local function tween(inst, time, props, style, dir)
		local t = TweenService:Create(
			inst,
			TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
			props
		)
		t:Play()
		return t
	end
	local function iconBase(parent, size)
		return new("Frame", {
			Parent = parent, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
		})
	end
	local function checkIcon(parent, color, size)
		size = size or 10
		local c = iconBase(parent, size)
		local s = size / 10
		for _, cfg in ipairs({
			{ pos = UDim2.fromScale(0.38, 0.55), sz = UDim2.fromOffset(math.floor(6*s), math.max(2, math.floor(2*s))), rot = 45 },
			{ pos = UDim2.fromScale(0.62, 0.45), sz = UDim2.fromOffset(math.floor(10*s), math.max(2, math.floor(2*s))), rot = -45 },
		}) do
			local bar = new("Frame", {
				Parent = c, AnchorPoint = Vector2.new(0.5, 0.5),
				Position = cfg.pos, Size = cfg.sz, BackgroundColor3 = color,
				BorderSizePixel = 0, Rotation = cfg.rot,
			})
			round(bar, 1)
		end
		return c
	end
	local function keyIcon(parent, color, size)
		size = size or 10
		local c = iconBase(parent, size)
		local s = size / 10
		local ring = new("Frame", {
			Parent = c, Position = UDim2.fromOffset(0, math.floor(2*s)),
			Size = UDim2.fromOffset(math.floor(5*s), math.floor(5*s)),
			BackgroundTransparency = 1,
		})
		round(ring, UDim.new(1, 0)); stroke(ring, color, 1.2, 0.15)
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(4*s), math.floor(4*s)),
			Size = UDim2.fromOffset(math.floor(6*s), math.max(1.5, math.floor(1.5*s))),
			BackgroundColor3 = color, BorderSizePixel = 0,
		})
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(8*s), math.floor(5*s)),
			Size = UDim2.fromOffset(math.max(1.5, math.floor(1.5*s)), math.floor(3*s)),
			BackgroundColor3 = color, BorderSizePixel = 0,
		})
		return c
	end
	local function globeIcon(parent, color, size)
		size = size or 10
		local c = iconBase(parent, size)
		local s = size / 10
		local circle = new("Frame", { Parent = c, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
		round(circle, UDim.new(1, 0)); stroke(circle, color, 1.2, 0.15)
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(0, math.floor(4*s)),
			Size = UDim2.fromOffset(size, math.max(1, math.floor(1*s))),
			BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		})
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(4*s), 0),
			Size = UDim2.fromOffset(math.max(1, math.floor(1*s)), size),
			BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		})
		return c
	end
	local function copyIcon(parent, color, size)
		size = size or 12
		local c = iconBase(parent, size)
		local s = size / 12
		local b1 = new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(3*s), 0),
			Size = UDim2.fromOffset(math.floor(9*s), math.floor(9*s)),
			BackgroundTransparency = 1,
		})
		round(b1, 2); stroke(b1, color, 1.2, 0.15)
		local b2 = new("Frame", {
			Parent = c, Position = UDim2.fromOffset(0, math.floor(3*s)),
			Size = UDim2.fromOffset(math.floor(9*s), math.floor(9*s)),
			BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 0.35, BorderSizePixel = 0,
		})
		round(b2, 2); stroke(b2, color, 1.2, 0.15)
		return c
	end
	local function saveIcon(parent, color, size)
		size = size or 12
		local c = iconBase(parent, size)
		local s = size / 12
		local floppy = new("Frame", { Parent = c, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
		round(floppy, 2); stroke(floppy, color, 1.3, 0.1)
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(3*s), 0),
			Size = UDim2.fromOffset(math.floor(6*s), math.floor(4*s)),
			BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		})
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(2*s), math.floor(7*s)),
			Size = UDim2.fromOffset(math.floor(8*s), math.floor(5*s)),
			BackgroundColor3 = color, BackgroundTransparency = 0.6, BorderSizePixel = 0,
		})
		return c
	end
	local function searchIcon(parent, color, size)
		size = size or 14
		local c = iconBase(parent, size)
		local s = size / 14
		local circle = new("Frame", {
			Parent = c, Size = UDim2.fromOffset(math.floor(10*s), math.floor(10*s)),
			BackgroundTransparency = 1,
		})
		round(circle, UDim.new(1, 0)); stroke(circle, color, 1.5, 0.15)
		new("Frame", {
			Parent = c, Position = UDim2.fromOffset(math.floor(8*s), math.floor(8*s)),
			Size = UDim2.fromOffset(math.floor(6*s), math.max(1.5, math.floor(1.5*s))),
			BackgroundColor3 = color, BorderSizePixel = 0, Rotation = 45,
		})
		return c
	end

	local Window = Auren:CreateWindow({
		Title      = "Auren",
		Subtitle   = "v4.1 • hub",
		Size       = Vector2.new(620, 440),
		ConfigName = "auren_hub",
	})

	local SavedScripts = {}
	local function isScriptSaved(id)
		for _, s in ipairs(SavedScripts) do
			if s._id == id then return true end
		end
		return false
	end

	local function fetchScripts(query, filters)
		local url = "https://scriptblox.com/api/script/search?q="
			.. HttpService:UrlEncode(query or "") .. "&max=20"
		if filters then
			if filters.key ~= nil then url = url .. "&key=" .. tostring(filters.key) end
			if filters.universal ~= nil then url = url .. "&universal=" .. tostring(filters.universal) end
			if filters.verified ~= nil then url = url .. "&verified=" .. tostring(filters.verified) end
		end
		local body
		if httpRequest then
			local ok, res = pcall(function() return httpRequest({ Url = url, Method = "GET" }) end)
			if ok and res and res.Body then body = res.Body end
		end
		if not body then
			local ok, res = pcall(function() return game:HttpGet(url) end)
			if ok then body = res end
		end
		if not body then return {} end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or not data or not data.result then return {} end
		return data.result.scripts or {}
	end
	local function fetchDetails(slug)
		local url = "https://scriptblox.com/api/script/" .. slug
		local body
		if httpRequest then
			local ok, res = pcall(function() return httpRequest({ Url = url, Method = "GET" }) end)
			if ok and res and res.Body then body = res.Body end
		end
		if not body then
			local ok, res = pcall(function() return game:HttpGet(url) end)
			if ok then body = res end
		end
		if not body then return nil end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or not data or not data.script then return nil end
		return data.script
	end
	local function copyText(text)
		if not setClipboard then return false end
		return pcall(setClipboard, text)
	end

	local function makeBadge(parent, label, color, iconType, order)
		local badge = new("Frame", {
			Parent = parent, Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color, BackgroundTransparency = 0.25,
			BorderSizePixel = 0, LayoutOrder = order, ZIndex = 12,
		})
		round(badge, 5)
		padding(badge, 0, 8, 0, 6)
		local inner = new("Frame", {
			Parent = badge, Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
		})
		new("UIListLayout", {
			Parent = inner, FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		})
		local holder = new("Frame", {
			Parent = inner, Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1, LayoutOrder = 1,
		})
		if iconType == "key" then keyIcon(holder, color, 10)
		elseif iconType == "check" then checkIcon(holder, color, 10)
		elseif iconType == "globe" then globeIcon(holder, color, 10) end
		new("TextLabel", {
			Parent = inner, Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Text = label, Font = Theme.FontBold, TextSize = 9,
			TextColor3 = color, LayoutOrder = 2, ZIndex = 13,
		})
		return badge
	end

	local HubTab = Window:AddTab("Hub", "•")
