			Parent = descScroll, Size = UDim2.new(1, 0, 0, 40),
			BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 102,
		})
		new("UIListLayout", {
			Parent = authorRow, FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		})
		local avatar = new("Frame", {
			Parent = authorRow, Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Window.Accent, BorderSizePixel = 0,
			LayoutOrder = 1, ZIndex = 103,
		})
		round(avatar, UDim.new(1, 0))
		new("TextLabel", {
			Parent = avatar, Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = string.upper(string.sub(details.owner and details.owner.username or "?", 1, 1)),
			Font = Theme.FontBold, TextSize = 13,
			TextColor3 = Color3.new(1, 1, 1), ZIndex = 104,
		})
		new("TextLabel", {
			Parent = authorRow, Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Text = details.owner and details.owner.username or "Unknown",
			Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, ZIndex = 103,
		})
		if details.owner and details.owner.verified then
			local vh = new("Frame", {
				Parent = authorRow, Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1, LayoutOrder = 3, ZIndex = 103,
			})
			checkIcon(vh, Theme.Blue, 14)
		end
