function Hub.recomputeMobile()
local cam=workspace.CurrentCamera
local vp=cam and cam.ViewportSize or Vector2.new(1280,720)
local shouldBeMobile
if Settings.MobileMode=="on" then shouldBeMobile=true
elseif Settings.MobileMode=="off" then shouldBeMobile=false
else shouldBeMobile=vp.X<700 or vp.Y<500 or UIS.TouchEnabled end
if shouldBeMobile~=Gui.Mobile then Gui.Mobile=shouldBeMobile Hub.rebuildLayout() end
end
function Hub.rebuildLayout()
if not Gui.Main then return end
local isSmall=Gui.Mobile
local scaleMap={Small=0.85,Medium=1.0,Large=1.15}
Gui.Scale=scaleMap[Settings.UIScale] or 1
if isSmall then Gui.Main.Size=UDim2.new(0.9,0,0.78,0)
else Gui.Main.Size=UDim2.new(0.78*Gui.Scale,0,0.7*Gui.Scale,0) end
local sbW=isSmall and 0 or math.floor(180*Gui.Scale)
if Gui.Sidebar then Gui.Sidebar.Size=UDim2.new(0,sbW,1,0) Gui.Sidebar.Visible=not isSmall end
if Gui.Content then Gui.Content.Position=UDim2.new(0,sbW,0,0) Gui.Content.Size=UDim2.new(1,-sbW,1,0) end
if Gui.MobileNav then Gui.MobileNav.Visible=isSmall and not State.Minimized end
end
