function Hub.open()
State.Minimized=false
if Gui.Main then Gui.Main.Visible=true end
if Gui.Floating then Gui.Floating.Visible=false end
if Gui.MobileNav then Gui.MobileNav.Visible=Gui.Mobile end
if Settings.Animations and Gui.Main then
Gui.Main.Size=UDim2.new(0,0,0,0)
Hub.rebuildLayout()
end
end
function Hub.close()
if State.Closing then return end
State.Closing=true
if Settings.Animations and Gui.Main then
local tw=U.tween(Gui.Main,0.18,{Size=UDim2.new(0,0,0,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
if tw then
tw.Completed:Connect(function() if Gui.Root then Gui.Root.Enabled=false end State.Closing=false end)
else if Gui.Root then Gui.Root.Enabled=false end State.Closing=false end
else
if Gui.Root then Gui.Root.Enabled=false end
State.Closing=false
end
end
function Hub.minimize(minimized)
State.Minimized=minimized
if minimized then
if Settings.Animations and Gui.Main then
local tw=U.tween(Gui.Main,0.2,{Size=UDim2.new(0,0,0,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
local function done()
if Gui.Main then Gui.Main.Visible=false end
Hub.rebuildLayout()
if Gui.Main then Gui.Main.Visible=false end
if Gui.Floating then Gui.Floating.Visible=true end
end
if tw then tw.Completed:Connect(done) else done() end
else
if Gui.Main then Gui.Main.Visible=false end
if Gui.Floating then Gui.Floating.Visible=true end
end
if Gui.MobileNav then Gui.MobileNav.Visible=false end
else
if Gui.Floating then Gui.Floating.Visible=false end
Hub.open()
end
end
