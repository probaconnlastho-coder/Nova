-- Require execution
local function runRequire()
local input=rBox.Text
if input=="" or input:match("^%s*$") then pushLine("error","No input provided.") return Notify.error("Require","Enter an asset ID or code.") end
local id=tonumber((input:gsub("%s","")))
if id then
pushLine("info","Requiring asset "..id.."…")
Notify.info("Require","Attempting require("..id..")")
task.spawn(function()
local ok,result=pcall(function() return require(id) end)
if ok then pushLine("success","Required "..id.." → "..typeof(result)) Notify.success("Require success","Asset "..id.." loaded.")
else pushLine("error","require failed: "..tostring(result)) Notify.error("Require failed",tostring(result)) end
end)
else
if type(loadstring)~="function" then pushLine("error","loadstring unavailable for non-numeric input.") return Notify.error("Require","loadstring unavailable.") end
pushLine("info","Non-numeric input — executing via loadstring…")
local fn,err=loadstring(input,"NovaRequire")
if not fn then pushLine("error","Compile error: "..tostring(err)) return Notify.error("Compile error",tostring(err)) end
local ok,res=pcall(fn)
if ok then pushLine("success","Executed. Result: "..tostring(res)) Notify.success("Executed","Code ran.")
else pushLine("error","Runtime error: "..tostring(res)) Notify.error("Runtime error",tostring(res)) end
end
end
-- Local execution
local function runLocal()
local code=codeBox.Text
if code=="" or code:match("^%s*$") then pushLine("error","Editor is empty.") return Notify.error("Execute","Nothing to run.") end
if type(loadstring)~="function" then pushLine("error","loadstring unavailable.") return Notify.error("Execute","loadstring unavailable.") end
pushLine("info","Compiling "..#code.." bytes…")
local fn,err=loadstring(code,"NovaLocalExec")
if not fn then pushLine("error","Compile error: "..tostring(err)) return Notify.error("Compile error",tostring(err)) end
pushLine("info","Executing…")
local ok,res=pcall(fn)
if ok then pushLine("success","Executed. Result: "..tostring(res)) Notify.success("Executed","Local code ran.")
else pushLine("error","Runtime error: "..tostring(res)) Notify.error("Runtime error",tostring(res)) end
end
rGo.MouseButton1Click:Connect(runRequire)
lGo.MouseButton1Click:Connect(runLocal)
rBox.FocusLost:Connect(function(enter) if enter then runRequire() end end)
clearBtn.MouseButton1Click:Connect(function() codeBox.Text="" pushLine("info","Editor cleared.") end)
