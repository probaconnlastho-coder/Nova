State.track(Gui.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
if State.Page=="Players" then Hub.refreshPlayerList()
elseif State.Page=="Commands" and Gui.CommandRender then Gui.CommandRender() end
end))
State.track(Gui.SearchBox.FocusLost:Connect(function(enter)
if enter then
local txt=Gui.SearchBox.Text
if txt:sub(1,1)==":" then Commands.execute(txt) Gui.SearchBox.Text="" end
end
end))
end
