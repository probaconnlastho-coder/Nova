function Hub.switchPage(name)
if not Gui.Pages[name] then return end
if State.Page==name then return end
local old=Gui.Pages[State.Page] local nw=Gui.Pages[name]
State.Page=name
if old then old.Visible=false end
nw.Visible=true
if Settings.Animations then nw.Position=UDim2.new(0,8,0,0) U.tween(nw,0.2,{Position=UDim2.new(0,0,0,0)},Enum.EasingStyle.Quint) end
if Gui.PageTitle then Gui.PageTitle.Text=name end
updateNavHighlight()
if name=="Players" then Hub.refreshPlayerList()
elseif name=="Ranks" then Hub.refreshRankDisplays()
elseif name=="Commands" and Gui.CommandRender then Gui.CommandRender()
elseif name=="Dashboard" then Hub.refreshDashboard() end
end
