elseif Exec.Clipboard then pcall(setclipboard,codeBox.Text) pushLine("success","Copied to clipboard.") Notify.success("Copied","Code copied.")
else pushLine("error","No file or clipboard API available.") Notify.warn("Save","No persistence API available.") end
end)
