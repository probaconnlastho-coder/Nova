local vp=cam and cam.ViewportSize or Vector2.new(1280,720)
Gui.Mobile=Settings.MobileMode=="on" or (Settings.MobileMode=="auto" and (vp.X<700 or vp.Y<500 or UIS.TouchEnabled))
buildMain()
buildSidebar()
buildTopBar()
buildPages()
buildMobileNav()
buildFloating()
buildNotifications()
buildMemes()
for name,page in pairs(Gui.Pages) do
local listRef=Gui.PageListRefs[name]
if listRef and Pages[name] then
local ok,err=pcall(Pages[name],listRef)
if not ok then warn("[Nova] page failed:",name,err) Notify.error("Page error",name.." failed: "..tostring(err)) end
end
end
local ok,err=pcall(OwnerScanner.scan)
if not ok then Notify.error("Owner verification unavailable",tostring(err)) end
if Gui.Pages.Dashboard then Gui.Pages.Dashboard.Visible=true end
State.Page="Dashboard"
updateNavHighlight()
Hub.rebuildLayout()
Hub.refreshDashboard()
Hub.refreshRankDisplays()
Hub.refreshPlayerList()
if State.Owner.verified then Notify.success("Owner verified","You are the confirmed owner.")
else Notify.warn("Owner not detected",State.Owner.reason) end
Notify.info("Client loaded","Executor: "..Exec.Name)
setupInput()
State.trackThread(task.spawn(function()
while true do
task.wait(5)
pcall(function()
if not Gui.Root or not Gui.Root.Parent then return end
if State.Page=="Players" then Hub.refreshPlayerList() end
if State.Page=="Dashboard" then Hub.refreshDashboard() end
end)
end
end))
end
local ok,err=pcall(boot)
if not ok then
warn("[Nova] boot() failed:",err)
pcall(function()
local fallbackParent=LP and LP:FindFirstChildOfClass("PlayerGui")
if not fallbackParent then fallbackParent=LP and LP:WaitForChild("PlayerGui",5) end
if fallbackParent then
local g=Instance.new("ScreenGui") g.Name="NovaFallback" g.ResetOnSpawn=false g.Parent=fallbackParent
local f=Instance.new("Frame") f.Size=UDim2.new(0,320,0,120) f.Position=UDim2.new(0.5,0,0.5,0) f.AnchorPoint=Vector2.new(0.5,0.5) f.BackgroundColor3=Color3.fromRGB(20,20,28) f.BorderSizePixel=0 f.Parent=g
local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,12) c.Parent=f
local t=Instance.new("TextLabel") t.Size=UDim2.new(1,-20,1,-20) t.Position=UDim2.new(0,10,0,10) t.BackgroundTransparency=1 t.Text="Nova Admin Hub failed to load.\n\nError:\n"..tostring(err) t.TextColor3=Color3.fromRGB(240,240,240) t.Font=Enum.Font.Gotham t.TextSize=12 t.TextWrapped=true t.TextXAlignment=Enum.TextXAlignment.Left t.TextYAlignment=Enum.TextYAlignment.Top t.Parent=f
end
end)
end
function _G.NovaCleanup()
for _,c in ipairs(State.Conn) do pcall(function() c:Disconnect() end) end
State.Conn={}
for _,t in ipairs(State.Threads) do pcall(function() task.cancel(t) end) end
State.Threads={}
if Gui.Root then pcall(function() Gui.Root:Destroy() end) Gui.Root=nil end
end
_G.NovaHub={Config=CFG,Settings=Settings,State=State,Commands=Commands,Ranks=Ranks,Notify=Notify,Executor=Exec,Hub=Hub,Cleanup=_G.NovaCleanup}
