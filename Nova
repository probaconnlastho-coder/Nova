function Commands.byName(n) for _,c in ipairs(Commands.Registry) do if c.name:lower()==tostring(n):lower() then return c end end end
function Commands.cats() local s,o={},{} for _,c in ipairs(Commands.Registry) do if not s[c.cat] then s[c.cat]=true o[#o+1]=c.cat end end table.sort(o) return o end
function Commands.execute(raw)
if type(raw)~="string" or raw=="" then return end
local text=raw:gsub("^%s*:?","") local parts={} for w in text:gmatch("%S+") do parts[#parts+1]=w end
if #parts==0 then return end
local name=parts[1]:lower() local def=Commands.byName(name)
if not def then return Notify.error("Unknown command",":"..name) end
if Ranks.level(Ranks.effective())<Ranks.level(def.rank) then return Notify.warn("Insufficient rank",(":%s requires %s"):format(def.name,def.rank)) end
local rest=table.concat(parts," ",2) local target,arg
if def.target:find("<player>") or def.target:find("<userId>") then
if parts[2] then local k=parts[2]:lower() for _,p in ipairs(Players:GetPlayers()) do if p.Name:lower()==k or p.DisplayName:lower()==k then target=p break end end end
arg=rest~="" and rest or nil
else arg=rest~="" and rest or nil end
local ok,err=pcall(function() def.run(arg,target) end)
if not ok then Notify.error("Command error",tostring(err)) end
end
