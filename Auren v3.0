	do
		-- Row: Artificial FPS Unlocker | [textbox] [toggle]
		local row = new("Frame", {
			Parent = perfHolder, Size = UDim2.new(1, 0, 0, 50),
			BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 44,
		})

		-- Label
		new("TextLabel", {
			Parent = row, Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -170, 1, 0), BackgroundTransparency = 1,
			Text = "Artificial FPS Unlocker", Font = Theme.Font, TextSize = 12,
			TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 45,
		})

		-- Textbox (default 360)
		local boxHolder = new("Frame", {
			Parent = row, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -72, 0.5, 0),
			Size = UDim2.fromOffset(56, 28),
			BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.35,
			BorderSizePixel = 0, ZIndex = 45,
		})
		round(boxHolder, 7)
		local boxStroke = stroke(boxHolder, Theme.Border, 1, 0.5)
		local fpsBox = new("TextBox", {
			Parent = boxHolder, Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, Text = "360",
			Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			PlaceholderText = "360", PlaceholderColor3 = Theme.SubText,
			ClearTextOnFocus = false, ZIndex = 46,
		})
		fpsBox.Focused:Connect(function()
			tween(boxStroke, 0.2, { Transparency = 0.15, Color = Window.Accent })
		end)
		fpsBox.FocusLost:Connect(function()
			tween(boxStroke, 0.2, { Transparency = 0.5, Color = Theme.Border })
			local n = tonumber(fpsBox.Text)
			if not n or n < 1 then
				fpsBox.Text = "360"
			else
				fpsBox.Text = tostring(math.floor(n))
				if fpsEnabled and setFpsCap then
					pcall(setFpsCap, math.floor(n))
					Window:Notify("FPS Updated", "Cap set to " .. math.floor(n) .. " FPS.", 3, "success")
				end
			end
		end)

		-- Toggle
		local track = new("TextButton", {
			Parent = row, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(46, 26),
			BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0,
			Text = "", AutoButtonColor = false, ZIndex = 45,
		})
		round(track, UDim.new(1, 0))
		stroke(track, Color3.new(1, 1, 1), 1, 0.88)
		local knob = new("Frame", {
			Parent = track, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = 46,
		})
		round(knob, UDim.new(1, 0))

		fpsEnabled = false
		local function render()
			tween(track, 0.25, { BackgroundColor3 = fpsEnabled and Theme.Green or Theme.SurfaceAlt })
			tween(knob, 0.32, { Position = UDim2.new(0, fpsEnabled and 22 or 2, 0.5, 0) },
				Enum.EasingStyle.Back)
		end

		track.MouseButton1Click:Connect(function()
			fpsEnabled = not fpsEnabled
			render()

			local targetFps = math.floor(tonumber(fpsBox.Text) or 360)

			if fpsEnabled then
				if setFpsCap then
					pcall(setFpsCap, targetFps)
					Window:Notify("FPS Unlocked", "Cap set to " .. targetFps .. " FPS.", 3, "success")
				else
					Window:Notify("Unavailable", "setfpscap not supported on this executor.", 3, "warning")
				end
				pcall(function()
					game:GetService("Lighting").GlobalShadows = false
				end)
			else
				if setFpsCap then pcall(setFpsCap, 60) end
				pcall(function()
					game:GetService("Lighting").GlobalShadows = true
				end)
				Window:Notify("FPS Reset", "Cap restored to 60 FPS.", 3, "info")
			end
		end)
	end

	-- Settings open/close
	local settingsOpen = false
	local function openSettings()
		if settingsOpen then return end
		settingsOpen = true
		settingsPanel.Visible = true
		settingsPanel.Position = UDim2.new(1, 10, 0, 0)
		tween(settingsPanel, 0.45, { Position = UDim2.new(0, 176, 0, 0) },
			Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	end
	local function closeSettings()
		if not settingsOpen then return end
		settingsOpen = false
		tween(settingsPanel, 0.4, { Position = UDim2.new(1, 10, 0, 0) },
			Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	end
	gearBtn.MouseButton1Click:Connect(openSettings)
	backBtn.MouseButton1Click:Connect(closeSettings)

	-- DRAG: WINDOW
	local windowDrag = {
		armed = false, moved = false,
		startTouchX = 0, startTouchY = 0,
		startPosX = 0, startPosY = 0,
	}
	local DRAG_THRESHOLD = 15

	local function mouseOverHeaderButton(mouseX, mouseY)
		for _, b in ipairs(headerButtons) do
			local ap, as = b.AbsolutePosition, b.AbsoluteSize
			if mouseX >= ap.X and mouseX <= ap.X + as.X
				and mouseY >= ap.Y and mouseY <= ap.Y + as.Y then
				return true
			end
		end
		return false
	end

	header.InputBegan:Connect(function(input)
		if not Window._dragEnabled then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if mouseOverHeaderButton(input.Position.X, input.Position.Y) then return end
		windowDrag.armed = true
		windowDrag.moved = false
		windowDrag.startTouchX = input.Position.X
		windowDrag.startTouchY = input.Position.Y
		windowDrag.startPosX = root.Position.X.Offset
		windowDrag.startPosY = root.Position.Y.Offset
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not windowDrag.armed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - windowDrag.startTouchX
		local dy = input.Position.Y - windowDrag.startTouchY
		if not windowDrag.moved then
			local mag = math.sqrt(dx*dx + dy*dy)
			if mag < DRAG_THRESHOLD then return end
			windowDrag.moved = true
			windowDrag.startTouchX = input.Position.X
			windowDrag.startTouchY = input.Position.Y
			windowDrag.startPosX = root.Position.X.Offset
			windowDrag.startPosY = root.Position.Y.Offset
			dx = 0
			dy = 0
			tween(rootScale, 0.15, { Scale = 1.015 }, Enum.EasingStyle.Quart)
		end
		local newX = windowDrag.startPosX + dx
		local newY = windowDrag.startPosY + dy
		local vpNow = (Camera and Camera.ViewportSize) or vp
		newX = math.clamp(newX, -root.AbsoluteSize.X + 110, vpNow.X - 110)
		newY = math.clamp(newY, 0, math.max(0, vpNow.Y - 46))
		root.Position = UDim2.fromOffset(newX, newY)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if windowDrag.armed then
			local wasMoving = windowDrag.moved
			windowDrag.armed = false
			windowDrag.moved = false
			if wasMoving then
				tween(rootScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Quart)
			end
		end
	end)

	-- TABS
	local TAB_H, TAB_GAP, TAB_TOP = 36, 4, 8

	local function refreshIndicator()
		local entry = Window._tabIndex[Window.CurrentTab]
		if entry and entry.Button.Visible then
			tween(indicator, 0.2, { BackgroundTransparency = 0.85 })
		else
			tween(indicator, 0.2, { BackgroundTransparency = 1 })
		end
	end

	function Window:AddTab(name, glyph)
		local index = #Window.Tabs + 1
		local btn = new("TextButton", {
			Parent = tabList, Size = UDim2.new(1, 0, 0, TAB_H),
			BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 1,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false,
			LayoutOrder = index, ZIndex = 7,
		})
		round(btn, 10)
		local glyphLbl = new("TextLabel", {
			Parent = btn, Position = UDim2.fromOffset(12, 0),
			Size = UDim2.fromOffset(18, TAB_H), BackgroundTransparency = 1,
			Text = glyph or "•", Font = Theme.Font, TextSize = 13,
			TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8,
		})
		local textLbl = new("TextLabel", {
			Parent = btn, Position = UDim2.fromOffset(34, 0),
			Size = UDim2.new(1, -42, 1, 0), BackgroundTransparency = 1,
			Text = name, Font = Theme.FontMedium, TextSize = 13,
			TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8,
		})
		local page = new("Frame", {
			Parent = content, Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, Visible = false, ZIndex = 5,
		})
		local scroll = new("ScrollingFrame", {
			Parent = page, Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1, BorderSizePixel = 0,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.SubText,
			ScrollBarImageTransparency = 0.55, ZIndex = 6,
		})
		new("UIListLayout", {
			Parent = scroll, Padding = UDim.new(0, 16), SortOrder = Enum.SortOrder.LayoutOrder,
		})
		padding(scroll, 2, 8, 14, 2)

		local tab = { Name = name, Button = btn, Page = page, Scroll = scroll, Index = index, _orders = 0 }
		function tab:_nextOrder() self._orders = self._orders + 1; return self._orders end

		function tab:AddSection(sectionName)
			local frame = new("Frame", {
				Parent = scroll, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, LayoutOrder = self:_nextOrder(), ZIndex = 6,
			})
			new("UIListLayout", {
				Parent = frame, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
			})
			new("TextLabel", {
				Parent = frame, Size = UDim2.new(1, 0, 0, 14),
				BackgroundTransparency = 1, Text = string.upper(sectionName),
				Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, ZIndex = 7,
			})
			local holder = new("Frame", {
				Parent = frame, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.3,
				BorderSizePixel = 0, LayoutOrder = 2, ZIndex = 7,
			})
			round(holder, 12)
			stroke(holder, Theme.Border, 1, 0.65)
			padding(holder, 4, 0, 4, 0)
			new("UIListLayout", { Parent = holder, SortOrder = Enum.SortOrder.LayoutOrder })
			local section = { Holder = holder, _orders = 0 }
			function section:_row(h, withSep)
				self._orders = self._orders + 1
				local row = new("Frame", {
					Parent = holder, Size = UDim2.new(1, 0, 0, h or 44),
					BackgroundTransparency = 1, LayoutOrder = self._orders, ZIndex = 8,
				})
				if withSep ~= false then
					new("Frame", {
						Parent = row, AnchorPoint = Vector2.new(0.5, 1),
						Position = UDim2.new(0.5, 0, 1, 0),
						Size = UDim2.new(1, -28, 0, 1),
						BackgroundColor3 = Theme.Divider, BackgroundTransparency = 0.4,
						BorderSizePixel = 0, ZIndex = 8,
					})
				end
				return row
			end
			function section:AddLabel(text)
				local row = self:_row(28)
				new("TextLabel", {
					Parent = row, Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1,
					Text = text, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9,
				})
			end
			function section:AddButton(text, callback)
				local row = self:_row(50)
				local btn = new("TextButton", {
					Parent = row, Position = UDim2.fromOffset(12, 5),
					Size = UDim2.new(1, -24, 0, 40),
					BackgroundColor3 = Window.Accent, BorderSizePixel = 0,
					Text = "", AutoButtonColor = false, ZIndex = 9,
				})
				round(btn, 10)
				local bg = gradient(btn, Window.Accent, Window.AccentAlt, 25)
				Window:BindAccent(btn, "BackgroundColor3", false)
				Window:BindAccent(bg, nil, false, "Gradient")
				stroke(btn, Color3.new(1, 1, 1), 1, 0.85)
				addRipple(btn); addPress(btn)
				new("TextLabel", {
					Parent = btn, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
					Text = text, Font = Theme.FontBold, TextSize = 13,
					TextColor3 = Color3.new(1, 1, 1), ZIndex = 10,
				})
				btn.MouseButton1Click:Connect(function()
					if callback then
						local ok, err = pcall(callback)
						if not ok then warn("[Auren] Button error:", err) end
					end
				end)
				return btn
			end
			function section:AddToggle(text, default, callback)
				local row = self:_row(44)
				new("TextLabel", {
					Parent = row, Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(1, -90, 1, 0), BackgroundTransparency = 1,
					Text = text, Font = Theme.Font, TextSize = 13,
					TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9,
				})
				local track = new("TextButton", {
					Parent = row, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -14, 0.5, 0),
					Size = UDim2.fromOffset(46, 26),
					BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0,
					Text = "", AutoButtonColor = false, ZIndex = 9,
				})
				round(track, UDim.new(1, 0))
				stroke(track, Color3.new(1, 1, 1), 1, 0.88)
				local knob = new("Frame", {
					Parent = track, AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 2, 0.5, 0),
					Size = UDim2.fromOffset(22, 22),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, ZIndex = 10,
				})
				round(knob, UDim.new(1, 0))
				local state = { Value = default and true or false }
				local function render()
					tween(track, 0.25, {
						BackgroundColor3 = state.Value and Theme.Green or Theme.SurfaceAlt
					})
					tween(knob, 0.32, {
						Position = UDim2.new(0, state.Value and 22 or 2, 0.5, 0)
					}, Enum.EasingStyle.Back)
				end
				function state:Set(v, silent)
					self.Value = v and true or false
					render()
					if not silent and callback then task.spawn(callback, self.Value) end
				end
				function state:Get() return state.Value end
				track.MouseButton1Click:Connect(function() state:Set(not state.Value) end)
				track.BackgroundColor3 = state.Value and Theme.Green or Theme.SurfaceAlt
				knob.Position = UDim2.new(0, state.Value and 22 or 2, 0.5, 0)
				return state
			end
			function section:AddSlider(text, min, max, default, callback)
				min = min or 0; max = max or 100
				default = math.clamp(default or min, min, max)
				local intMode = (min == math.floor(min)) and (max == math.floor(max))
				local row = self:_row(56)
				new("TextLabel", {
					Parent = row, Position = UDim2.fromOffset(14, 8),
					Size = UDim2.new(1, -90, 0, 16), BackgroundTransparency = 1,
					Text = text, Font = Theme.Font, TextSize = 13,
					TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9,
				})
				local valueLbl = new("TextLabel", {
					Parent = row, AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 8),
					Size = UDim2.new(0, 70, 0, 16),
					BackgroundTransparency = 1, Text = tostring(math.floor(default)),
					Font = Theme.FontBold, TextSize = 12, TextColor3 = Window.Accent,
					TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 9,
				})
				Window:BindAccent(valueLbl, "TextColor3", false)
				local track = new("Frame", {
					Parent = row, Position = UDim2.fromOffset(14, 34),
					Size = UDim2.new(1, -28, 0, 5),
					BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0, ZIndex = 9,
				})
				round(track, UDim.new(1, 0))
				local fill = new("Frame", {
					Parent = track, Size = UDim2.new(0, 0, 1, 0),
					BackgroundColor3 = Window.Accent, BorderSizePixel = 0, ZIndex = 10,
				})
				round(fill, UDim.new(1, 0))
				local fillGrad = gradient(fill, Window.Accent, Window.AccentAlt, 0)
				Window:BindAccent(fill, "BackgroundColor3", false)
				Window:BindAccent(fillGrad, nil, false, "Gradient")
				local knob = new("Frame", {
					Parent = track, AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, ZIndex = 11,
				})
				round(knob, UDim.new(1, 0))
				stroke(knob, Color3.new(0, 0, 0), 1, 0.85)
				local hitbox = new("TextButton", {
					Parent = row, Position = UDim2.fromOffset(14, 22),
					Size = UDim2.new(1, -28, 0, 30),
					BackgroundTransparency = 1, Text = "",
					AutoButtonColor = false, ZIndex = 12,
				})
				local state = { Value = default, Min = min, Max = max }
				local draggingSlider = false
				local function apply(value, fire)
					value = math.clamp(value, min, max)
					local alpha = (max - min > 0) and ((value - min) / (max - min)) or 0
					state.Value = value
					fill.Size = UDim2.fromScale(alpha, 1)
					knob.Position = UDim2.new(alpha, 0, 0.5, 0)
					valueLbl.Text = intMode and tostring(math.floor(value + 0.5))
						or string.format("%.2f", value)
					if fire and callback then task.spawn(callback, value) end
				end
				local function fromInput(input)
					local rel = (input.Position.X - track.AbsolutePosition.X)
						/ math.max(track.AbsoluteSize.X, 1)
					apply(min + (max - min) * math.clamp(rel, 0, 1), true)
				end
				hitbox.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = true
						fromInput(input)
						tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not draggingSlider then return end
					if input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch then
						fromInput(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						if draggingSlider then
							draggingSlider = false
							tween(knob, 0.25, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
						end
					end
				end)
				function state:Set(v, silent) apply(v, not silent) end
				function state:Get() return state.Value end
				apply(default, false)
				return state
			end
			function section:AddDropdown(text, options, default, callback)
				options = options or {}
				local selected = default or options[1]
				local row = new("Frame", {
					Parent = holder, Size = UDim2.new(1, 0, 0, 44),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1, LayoutOrder = self:_nextOrder(), ZIndex = 8,
				})
				new("UIListLayout", { Parent = row, SortOrder = Enum.SortOrder.LayoutOrder })
				new("Frame", {
					Parent = row, AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 44),
					Size = UDim2.new(1, -28, 0, 1),
					BackgroundColor3 = Theme.Divider, BackgroundTransparency = 0.4,
					BorderSizePixel = 0, ZIndex = 9,
				})
				local head = new("TextButton", {
					Parent = row, Size = UDim2.new(1, 0, 0, 44),
					BackgroundTransparency = 1, Text = "",
					AutoButtonColor = false, ZIndex = 9, LayoutOrder = 1,
				})
				new("TextLabel", {
					Parent = head, Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(1, -140, 1, 0), BackgroundTransparency = 1,
					Text = text, Font = Theme.Font, TextSize = 13,
					TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 10,
				})
				local valueLbl = new("TextLabel", {
					Parent = head, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -34, 0.5, 0),
					Size = UDim2.new(0, 100, 0, 16), BackgroundTransparency = 1,
					Text = tostring(selected), Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Right,
					TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 10,
				})
				local chev = new("Frame", {
					Parent = head, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -14, 0.5, 0),
					Size = UDim2.fromOffset(6, 6), BackgroundTransparency = 1, ZIndex = 10,
				})
				makeChevron(chev, Theme.SubText, 6)
				local listHolder = new("Frame", {
					Parent = row, Size = UDim2.new(1, 0, 0, 0),
					BackgroundTransparency = 1, ClipsDescendants = true,
					ZIndex = 9, LayoutOrder = 2,
				})
				padding(listHolder, 0, 12, 8, 12)
				new("UIListLayout", {
					Parent = listHolder, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
				})
				local open = false
				local checks = {}
				local function closeList()
					open = false
					tween(listHolder, 0.28, { Size = UDim2.new(1, 0, 0, 0) },
						Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
					tween(chev, 0.28, { Rotation = 0 }, Enum.EasingStyle.Back)
				end
				local function openList()
					open = true
					local h = #options * 34 + math.max(0, #options - 1) * 4 + 8
					tween(listHolder, 0.32, { Size = UDim2.new(1, 0, 0, h) }, Enum.EasingStyle.Back)
					tween(chev, 0.32, { Rotation = 180 }, Enum.EasingStyle.Back)
				end
				for i, opt in ipairs(options) do
					local item = new("TextButton", {
						Parent = listHolder, Size = UDim2.new(1, 0, 0, 34),
						BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.55,
						BorderSizePixel = 0, Text = "", AutoButtonColor = false,
						LayoutOrder = i, ZIndex = 10,
					})
					round(item, 8)
					new("TextLabel", {
						Parent = item, Position = UDim2.fromOffset(12, 0),
						Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1,
						Text = tostring(opt), Font = Theme.Font, TextSize = 12,
						TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11,
					})
					local check = new("Frame", {
						Parent = item, AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -12, 0.5, 0),
						Size = UDim2.fromOffset(6, 6),
						BackgroundColor3 = Window.Accent, BorderSizePixel = 0,
						ZIndex = 11, Visible = (opt == selected),
					})
					round(check, UDim.new(1, 0))
					Window:BindAccent(check, "BackgroundColor3", false)
					checks[opt] = check
					item.MouseEnter:Connect(function()
						tween(item, 0.15, { BackgroundTransparency = 0.25 })
					end)
					item.MouseLeave:Connect(function()
						tween(item, 0.15, { BackgroundTransparency = 0.55 })
					end)
					item.MouseButton1Click:Connect(function()
						selected = opt
						valueLbl.Text = tostring(opt)
						for k, c in pairs(checks) do c.Visible = (k == opt) end
						closeList()
						if callback then task.spawn(callback, opt) end
					end)
				end
				head.MouseButton1Click:Connect(function()
					if open then closeList() else openList() end
				end)
				local state = {}
				function state:Get() return selected end
				function state:Set(v)
					if checks[v] then
						selected = v
						valueLbl.Text = tostring(v)
						for k, c in pairs(checks) do c.Visible = (k == v) end
					end
				end
				state.Options = options
				return state
			end
			function section:AddTextbox(text, placeholder, callback)
				local row = self:_row(46)
				new("TextLabel", {
					Parent = row, Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(0.5, -14, 1, 0), BackgroundTransparency = 1,
					Text = text, Font = Theme.Font, TextSize = 13,
					TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9,
				})
				local boxHolder = new("Frame", {
					Parent = row, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -14, 0.5, 0),
					Size = UDim2.new(0, 170, 0, 30),
					BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.35,
					BorderSizePixel = 0, ZIndex = 9,
				})
				round(boxHolder, 8)
				local boxStroke = stroke(boxHolder, Theme.Border, 1, 0.5)
				local box = new("TextBox", {
					Parent = boxHolder, Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -20, 1, 0),
					BackgroundTransparency = 1, Text = "",
					PlaceholderText = placeholder or "Enter…",
					PlaceholderColor3 = Theme.SubText, Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false, ZIndex = 10,
				})
				box.Focused:Connect(function()
					tween(boxStroke, 0.2, { Transparency = 0.2, Color = Window.Accent })
					tween(boxHolder, 0.2, { BackgroundTransparency = 0.15 })
				end)
				box.FocusLost:Connect(function(enter)
					tween(boxStroke, 0.2, { Transparency = 0.5, Color = Theme.Border })
					tween(boxHolder, 0.2, { BackgroundTransparency = 0.35 })
					if enter and callback then task.spawn(callback, box.Text) end
				end)
				local state = {}
				function state:Get() return box.Text end
				function state:Set(v) box.Text = tostring(v) end
				return state
			end
			return section
		end

		local function selectTab()
			if Window.CurrentTab == index then return end
			local oldIndex = Window.CurrentTab
			Window.CurrentTab = index
			if oldIndex > 0 and Window.Pages[oldIndex] then
				Window.Pages[oldIndex].Visible = false
				local old = Window.Tabs[oldIndex]
				if old then
					tween(old.TextLabel, 0.2, { TextColor3 = Theme.SubText })
					tween(old.Glyph, 0.2, { TextColor3 = Theme.SubText })
				end
			end
			for i, t in ipairs(Window.Tabs) do
				if i ~= index then
					tween(t.Button, 0.15, { BackgroundTransparency = 1 })
				end
			end
			page.Visible = true
			tween(textLbl, 0.2, { TextColor3 = Theme.Text })
			tween(glyphLbl, 0.2, { TextColor3 = Color3.new(1, 1, 1) })
			tween(indicator, 0.36, {
				Position = UDim2.fromOffset(8, TAB_TOP + (index - 1) * (TAB_H + TAB_GAP)),
			}, Enum.EasingStyle.Back)
			refreshIndicator()
		end
		btn.MouseEnter:Connect(function()
			tween(btn, 0.15, { BackgroundTransparency = 0.72 })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, 0.15, { BackgroundTransparency = 1 })
		end)
		btn.MouseButton1Click:Connect(selectTab)
		table.insert(Window.Tabs, { TextLabel = textLbl, Glyph = glyphLbl, Button = btn })
		Window.Pages[index] = page
		table.insert(Window._tabIndex, { Name = name, Button = btn, TabIndex = index })
		if index == 1 then
			Window.CurrentTab = 0
			selectTab()
		end
		return tab
	end

	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(searchInput.Text)
		for _, entry in ipairs(Window._tabIndex) do
			local matches = (q == "") or string.find(string.lower(entry.Name), q, 1, true) ~= nil
			entry.Button.Visible = matches
		end
		refreshIndicator()
	end)

	-- NOTIFICATIONS
	local toastHolder = new("Frame", {
		Parent = screen, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Size = UDim2.fromOffset(340, 400),
		BackgroundTransparency = 1, ZIndex = 200,
	})
	local activeToasts = {}
	local TOAST_HEIGHT = 90
	local TOAST_GAP = 12
	local function repositionToasts(animate)
		for i, toast in ipairs(activeToasts) do
			local targetY = (i - 1) * (TOAST_HEIGHT + TOAST_GAP)
			local targetPos = UDim2.fromOffset(0, targetY)
			if animate then
				tween(toast, 0.35, { Position = targetPos },
					Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			else
				toast.Position = targetPos
			end
		end
	end
	local function makeNotifIcon(parent, kind)
		local color = Theme.Accent
		local label = "i"
		if kind == "success" then color = Theme.Green
		elseif kind == "warning" then color = Theme.Yellow; label = "!"
		elseif kind == "error" then color = Theme.Red; label = "!" end
		local circle = new("Frame", {
			Parent = parent, Position = UDim2.fromOffset(16, 16),
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 202,
		})
		round(circle, UDim.new(1, 0))
		if kind == "success" then
			makeCheckIcon(circle, Color3.new(1, 1, 1), 20)
		elseif kind == "error" then
			for _, rot in ipairs({ 45, -45 }) do
				local bar = new("Frame", {
					Parent = circle, AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(18, 2.5),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, Rotation = rot, ZIndex = 203,
				})
				round(bar, 1)
			end
		else
			new("TextLabel", {
				Parent = circle, Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1, Text = label,
				Font = Theme.FontBold, TextSize = 18,
				TextColor3 = Color3.new(1, 1, 1), ZIndex = 203,
			})
		end
	end
	function Window:Notify(title, message, duration, kind)
		duration = duration or 4
		kind = kind or "info"
		local toast = new("Frame", {
			Parent = toastHolder, Size = UDim2.fromOffset(340, TOAST_HEIGHT),
			Position = UDim2.fromOffset(80, 0),
			BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.05,
			BorderSizePixel = 0, ZIndex = 201, ClipsDescendants = true,
		})
		round(toast, 14)
		stroke(toast, Theme.Border, 1, 0.55)
		local toastScale = Instance.new("UIScale")
		toastScale.Scale = 0.85
		toastScale.Parent = toast
		makeNotifIcon(toast, kind)
		new("TextLabel", {
			Parent = toast, Position = UDim2.fromOffset(68, 16),
			Size = UDim2.new(1, -84, 0, 18), BackgroundTransparency = 1,
			Text = title, Font = Theme.FontBold, TextSize = 14,
			TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 202,
		})
		new("TextLabel", {
			Parent = toast, Position = UDim2.fromOffset(68, 36),
			Size = UDim2.new(1, -84, 0, 42), BackgroundTransparency = 1,
			Text = message or "", Font = Theme.Font, TextSize = 11,
			TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 202,
		})
		local barBg = new("Frame", {
			Parent = toast, AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = Color3.fromRGB(40, 40, 40),
			BorderSizePixel = 0, ZIndex = 202,
		})
		local bar = new("Frame", {
			Parent = barBg, Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = (kind == "success" and Theme.Green)
				or (kind == "warning" and Theme.Yellow)
				or (kind == "error" and Theme.Red)
				or Theme.Accent,
			BorderSizePixel = 0, ZIndex = 203,
		})
		table.insert(activeToasts, 1, toast)
		repositionToasts(false)
		tween(toast, 0.55, { Position = UDim2.fromOffset(0, toast.Position.Y.Offset) },
			Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(toastScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(toast, 0.35, { BackgroundTransparency = 0.02 })
		tween(bar, duration, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear)
		task.delay(duration, function()
			tween(toast, 0.4, { Position = UDim2.fromOffset(100, toast.Position.Y.Offset) },
				Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tween(toastScale, 0.4, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
			tween(toast, 0.4, { BackgroundTransparency = 1 })
			task.delay(0.45, function()
				for i, t in ipairs(activeToasts) do
					if t == toast then table.remove(activeToasts, i); break end
				end
				if toast and toast.Parent then toast:Destroy() end
				repositionToasts(true)
			end)
		end)
	end

	-- FLOATING PILL BUTTON (Rayfield-style)
	local floating = new("TextButton", {
		Parent = screen,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 20),
		Size = UDim2.fromOffset(220, 50),
		BackgroundColor3 = Color3.fromRGB(18, 18, 20),
		BorderSizePixel = 0, Text = "",
		AutoButtonColor = false, Visible = false, ZIndex = 300,
	})
	round(floating, 25)
	stroke(floating, Color3.fromRGB(40, 40, 44), 1, 0.5)

	new("ImageLabel", {
		Parent = floating,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 1,
		Image = "rbxassetid://83962252931992",
		ImageColor3 = Color3.new(1, 1, 1),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 301,
	})
	new("TextLabel", {
		Parent = floating, Position = UDim2.new(0, 54, 0, 10),
		Size = UDim2.new(1, -64, 0, 16), BackgroundTransparency = 1,
		Text = "Auren", Font = Enum.Font.GothamBold, TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 301,
	})
	new("TextLabel", {
		Parent = floating, Position = UDim2.new(0, 54, 0, 26),
		Size = UDim2.new(1, -64, 0, 14), BackgroundTransparency = 1,
		Text = "Tap to show", Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = Color3.fromRGB(150, 150, 155),
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 301,
	})

	local floatScale = addScale(floating)
	local floatDrag = {
		armed = false, moved = false,
		startTouchX = 0, startTouchY = 0,
		startPosX = 0, startPosY = 0,
	}
	floating.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		floatDrag.armed = true
		floatDrag.moved = false
		floatDrag.startTouchX = input.Position.X
		floatDrag.startTouchY = input.Position.Y
		floatDrag.startPosX = floating.Position.X.Offset
		floatDrag.startPosY = floating.Position.Y.Offset
		tween(floatScale, 0.15, { Scale = 0.96 })
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not floatDrag.armed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - floatDrag.startTouchX
		local dy = input.Position.Y - floatDrag.startTouchY
		if not floatDrag.moved then
			local mag = math.sqrt(dx*dx + dy*dy)
			if mag < DRAG_THRESHOLD then return end
			floatDrag.moved = true
			floatDrag.startTouchX = input.Position.X
			floatDrag.startTouchY = input.Position.Y
			floatDrag.startPosX = floating.Position.X.Offset
			floatDrag.startPosY = floating.Position.Y.Offset
			dx = 0
			dy = 0
		end
		floating.Position = UDim2.fromOffset(
			floatDrag.startPosX + dx, floatDrag.startPosY + dy)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if floatDrag.armed then
			local wasMoving = floatDrag.moved
			floatDrag.armed = false
			floatDrag.moved = false
			if not wasMoving then Window:Open() end
			tween(floatScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Quart)
		end
	end)

	-- WINDOW STATE
	local busy = false
	function Window:Minimize()
		if busy then return end
		busy = true
		fader.BackgroundTransparency = 1
		tween(fader, 0.28, { BackgroundTransparency = 0.02 })
		tween(rootScale, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.32, function()
			root.Visible = false
			rootScale.Scale = 1
			fader.BackgroundTransparency = 1
			floating.Visible = true
			floating.Size = UDim2.fromOffset(40, 10)
			tween(floating, 0.45, { Size = UDim2.fromOffset(220, 50) },
				Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			busy = false
		end)
	end
	function Window:Open()
		if busy then return end
		busy = true
		tween(floating, 0.28, { Size = UDim2.fromOffset(40, 10) },
			Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.3, function()
			floating.Visible = false
			root.Visible = true
			rootScale.Scale = 0.85
			fader.BackgroundTransparency = 0.02
			tween(rootScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(fader, 0.4, { BackgroundTransparency = 1 })
			busy = false
		end)
	end
	function Window:Destroy()
		if busy then return end
		busy = true
		fader.BackgroundTransparency = 1
		tween(fader, 0.28, { BackgroundTransparency = 0.02 })
		tween(rootScale, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.32, function()
			if screen and screen.Parent then screen:Destroy() end
			busy = false
		end)
	end
	minBtn.MouseButton1Click:Connect(function() Window:Minimize() end)
	closeBtn.MouseButton1Click:Connect(function() Window:Destroy() end)
	task.delay(2, function()
		if screen and not screen.Parent then
			screen.Parent = LocalPlayer:WaitForChild("PlayerGui")
		end
	end)
	print("[Auren] Window ready. Parent =", parentName)
	return Window
end

--// ══════════════════════════════════════════════════════════
--//  OPTIONAL: Load from URL (mirrors executor-safe loading)
--// ══════════════════════════════════════════════════════════
function Library:LoadFromUrl(url)
	if not url then return self end
	local ok, src = pcall(function() return game:HttpGet(url) end)
	if not ok then
		warn("[Auren] Failed to load from URL")
		return self
	end
	local fn, err = loadstring(src)
	if not fn then
		warn("[Auren] Loadstring error:", err)
		return self
	end
	pcall(fn)
	return self
end

return Library
