--[[
════════════════════════════════════════════════════════════════════
  Auren UI Library  •  v3.0
  Cross-Executor iOS-style interface for Roblox executors
════════════════════════════════════════════════════════════════════

  USAGE:
    local Auren = loadstring(game:HttpGet("YOUR_URL_HERE"))()
    -- or require if you host it as a ModuleScript

    local Window = Auren:CreateWindow({
        Title    = "My Script",
        Subtitle = "v1.0",
        Size     = Vector2.new(620, 440),
    })

    local Tab     = Window:AddTab("Main", "•")
    local Section = Tab:AddSection("General")

    Section:AddLabel("Hello world")
    Section:AddButton("Click", function() end)
    Section:AddToggle("Enable", false, function(v) end)
    Section:AddSlider("Speed", 0, 100, 50, function(v) end)
    Section:AddDropdown("Mode", {"A","B"}, "A", function(v) end)
    Section:AddTextbox("Name", "Enter…", function(t) end)

    Window:Notify("Title", "Message", 4, "success")
    -- kinds: "info" | "success" | "warning" | "error"

    Window:Minimize()  Window:Open()  Window:Destroy()

  METHODS:
    Auren:CreateWindow(cfg)   -> Window
    Window:AddTab(name, glyph)
    Window:Notify(title, msg, dur, kind)
    Window:SetAccent(color1, color2)
    Window:Minimize() / Open() / Destroy()
    Tab:AddSection(name)
    Section:Add{Label,Button,Toggle,Slider,Dropdown,Textbox}

════════════════════════════════════════════════════════════════════
]]

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")
local HttpService      = game:GetService("HttpService")

--// ══════════════════════════════════════════════════════════
--//  EXECUTOR COMPATIBILITY LAYER
--// ══════════════════════════════════════════════════════════
local httpRequest  = (syn and syn.request) or http_request or request
	or (http and http.request) or (fluxus and fluxus.request)
local setClipboard = setclipboard or toclipboard or set_clipboard
	or (syn and syn.write_clipboard)
local getHiddenUI  = gethui or get_hidden_gui
local protectGUI   = (syn and syn.protect_gui) or nil
local setFpsCap    = setfpscap or set_fps_cap or nil

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	repeat task.wait() until Players.LocalPlayer
	LocalPlayer = Players.LocalPlayer
end
if not game:IsLoaded() then pcall(function() game.Loaded:Wait() end) end

local Camera = workspace.CurrentCamera
if not Camera then
	repeat task.wait() until workspace.CurrentCamera
	Camera = workspace.CurrentCamera
end

--// ══════════════════════════════════════════════════════════
--//  THEME
--// ══════════════════════════════════════════════════════════
local Theme = {
	Background   = Color3.fromRGB(8, 8, 10),
	Surface      = Color3.fromRGB(20, 20, 22),
	SurfaceAlt   = Color3.fromRGB(32, 32, 36),
	SurfaceHover = Color3.fromRGB(46, 46, 50),
	Text         = Color3.fromRGB(255, 255, 255),
	SubText      = Color3.fromRGB(130, 130, 135),
	Divider      = Color3.fromRGB(46, 46, 50),
	Border       = Color3.fromRGB(55, 55, 60),
	Green        = Color3.fromRGB(48, 209, 88),
	Red          = Color3.fromRGB(255, 69, 58),
	Yellow       = Color3.fromRGB(255, 189, 46),
	Blue         = Color3.fromRGB(10, 132, 255),
	Purple       = Color3.fromRGB(175, 82, 222),
	Accent       = Color3.fromRGB(150, 150, 155),
	AccentAlt    = Color3.fromRGB(110, 110, 115),
	Font         = Enum.Font.Gotham,
	FontMedium   = Enum.Font.GothamMedium,
	FontBold     = Enum.Font.GothamBold,
}

local Library = { Theme = Theme, _version = "3.0" }

--// ══════════════════════════════════════════════════════════
--//  HELPERS
--// ══════════════════════════════════════════════════════════
local function new(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end
local function round(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius)
	c.Parent = inst
	return c
end
local function stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(1, 1, 1)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.85
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end
local function gradient(inst, c1, c2, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rotation or 0
	g.Parent = inst
	return g
end
local function tween(inst, time, props, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end
local function padding(inst, t, r, b, l)
	local p = Instance.new("UIPadding")
	p.PaddingTop, p.PaddingRight = UDim.new(0, t or 0), UDim.new(0, r or 0)
	p.PaddingBottom, p.PaddingLeft = UDim.new(0, b or 0), UDim.new(0, l or 0)
	p.Parent = inst
	return p
end
local function addScale(inst)
	local s = Instance.new("UIScale")
	s.Scale = 1
	s.Parent = inst
	return s
end

-- ICONS
local function makeIconBase(parent, size)
	return new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	})
end
local function makeCopyIcon(parent, color, size)
	size = size or 12
	local c = makeIconBase(parent, size)
	local s = size / 12
	local b1 = new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(3*s), 0),
		Size = UDim2.fromOffset(math.floor(9*s), math.floor(9*s)), BackgroundTransparency = 1 })
	round(b1, 2); stroke(b1, color, 1.2, 0.15)
	local b2 = new("Frame", { Parent = c, Position = UDim2.fromOffset(0, math.floor(3*s)),
		Size = UDim2.fromOffset(math.floor(9*s), math.floor(9*s)),
		BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 0.35, BorderSizePixel = 0 })
	round(b2, 2); stroke(b2, color, 1.2, 0.15)
	return c
end
local function makeSaveIcon(parent, color, size)
	size = size or 12
	local c = makeIconBase(parent, size)
	local s = size / 12
	local floppy = new("Frame", { Parent = c, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	round(floppy, 2); stroke(floppy, color, 1.3, 0.1)
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(3*s), 0),
		Size = UDim2.fromOffset(math.floor(6*s), math.floor(4*s)),
		BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0 })
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(2*s), math.floor(7*s)),
		Size = UDim2.fromOffset(math.floor(8*s), math.floor(5*s)),
		BackgroundColor3 = color, BackgroundTransparency = 0.6, BorderSizePixel = 0 })
	return c
end
local function makeCheckIcon(parent, color, size)
	size = size or 10
	local c = makeIconBase(parent, size)
	local s = size / 10
	local l1 = new("Frame", { Parent = c, AnchorPoint = Vector2.new(0.5,0.5),
		Position = UDim2.fromScale(0.38, 0.55),
		Size = UDim2.fromOffset(math.floor(6*s), math.max(2, math.floor(2*s))),
		BackgroundColor3 = color, BorderSizePixel = 0, Rotation = 45 })
	round(l1, 1)
	local l2 = new("Frame", { Parent = c, AnchorPoint = Vector2.new(0.5,0.5),
		Position = UDim2.fromScale(0.62, 0.45),
		Size = UDim2.fromOffset(math.floor(10*s), math.max(2, math.floor(2*s))),
		BackgroundColor3 = color, BorderSizePixel = 0, Rotation = -45 })
	round(l2, 1)
	return c
end
local function makeKeyIcon(parent, color, size)
	size = size or 10
	local c = makeIconBase(parent, size)
	local s = size / 10
	local ring = new("Frame", { Parent = c, Position = UDim2.fromOffset(0, math.floor(2*s)),
		Size = UDim2.fromOffset(math.floor(5*s), math.floor(5*s)), BackgroundTransparency = 1 })
	round(ring, UDim.new(1, 0)); stroke(ring, color, 1.2, 0.15)
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(4*s), math.floor(4*s)),
		Size = UDim2.fromOffset(math.floor(6*s), math.max(1.5, math.floor(1.5*s))),
		BackgroundColor3 = color, BorderSizePixel = 0 })
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(8*s), math.floor(5*s)),
		Size = UDim2.fromOffset(math.max(1.5, math.floor(1.5*s)), math.floor(3*s)),
		BackgroundColor3 = color, BorderSizePixel = 0 })
	return c
end
local function makeGlobeIcon(parent, color, size)
	size = size or 10
	local c = makeIconBase(parent, size)
	local s = size / 10
	local circle = new("Frame", { Parent = c, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	round(circle, UDim.new(1, 0)); stroke(circle, color, 1.2, 0.15)
	new("Frame", { Parent = c, Position = UDim2.fromOffset(0, math.floor(4*s)),
		Size = UDim2.fromOffset(size, math.max(1, math.floor(1*s))),
		BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0 })
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(4*s), 0),
		Size = UDim2.fromOffset(math.max(1, math.floor(1*s)), size),
		BackgroundColor3 = color, BackgroundTransparency = 0.4, BorderSizePixel = 0 })
	return c
end
local function makeSearchIcon(parent, color, size)
	size = size or 14
	local c = makeIconBase(parent, size)
	local s = size / 14
	local circle = new("Frame", { Parent = c, Size = UDim2.fromOffset(math.floor(10*s), math.floor(10*s)), BackgroundTransparency = 1 })
	round(circle, UDim.new(1, 0)); stroke(circle, color, 1.5, 0.15)
	new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(8*s), math.floor(8*s)),
		Size = UDim2.fromOffset(math.floor(6*s), math.max(1.5, math.floor(1.5*s))),
		BackgroundColor3 = color, BorderSizePixel = 0, Rotation = 45 })
	return c
end
local function makeSlidersIcon(parent, color, size)
	size = size or 16
	local c = makeIconBase(parent, size)
	local s = size / 16
	for i = 1, 3 do
		local y = (i - 1) * 6
		local bar = new("Frame", { Parent = c, Position = UDim2.fromOffset(0, math.floor((y + 2)*s)),
			Size = UDim2.new(1, 0, 0, math.max(2, math.floor(2*s))),
			BackgroundColor3 = color, BorderSizePixel = 0 })
		round(bar, 1)
		local knobX = i == 1 and 3 or (i == 2 and 10 or 6)
		local knob = new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(knobX*s), math.floor(y*s)),
			Size = UDim2.fromOffset(math.floor(6*s), math.floor(6*s)),
			BackgroundColor3 = color, BorderSizePixel = 0 })
		round(knob, UDim.new(1, 0))
	end
	return c
end
local function makeChevron(parent, color, size)
	size = size or 6
	local c = new("Frame", { Parent = parent, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	local s = size / 6
	local a = new("Frame", { Parent = c, Position = UDim2.fromOffset(0, math.floor(2*s)),
		Size = UDim2.fromOffset(math.floor(5*s), math.max(1.5, math.floor(1.5*s))),
		BackgroundColor3 = color, BorderSizePixel = 0, Rotation = 45 })
	round(a, 1)
	local b = new("Frame", { Parent = c, Position = UDim2.fromOffset(math.floor(3*s), math.floor(2*s)),
		Size = UDim2.fromOffset(math.floor(5*s), math.max(1.5, math.floor(1.5*s))),
		BackgroundColor3 = color, BorderSizePixel = 0, Rotation = -45 })
	round(b, 1)
	return c
end

local function addRipple(btn, color)
	btn.ClipsDescendants = true
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local rel = Vector2.new(
			input.Position.X - btn.AbsolutePosition.X,
			input.Position.Y - btn.AbsolutePosition.Y
		)
		local r = new("Frame", {
			Parent = btn, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(rel.X, rel.Y),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = color or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72, BorderSizePixel = 0,
			ZIndex = (btn.ZIndex or 1) + 2,
		})
		round(r, UDim.new(1, 0))
		local maxSize = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.4
		tween(r, 0.55, { Size = UDim2.fromOffset(maxSize, maxSize), BackgroundTransparency = 1 },
			Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		task.delay(0.6, function() if r and r.Parent then r:Destroy() end end)
	end)
end
local function addPress(btn, base)
	local sc = addScale(btn)
	base = base or 0.95
	btn.MouseEnter:Connect(function() tween(sc, 0.18, { Scale = 1.06 }) end)
	btn.MouseLeave:Connect(function() tween(sc, 0.18, { Scale = 1 }) end)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = base }) end)
	btn.MouseButton1Up:Connect(function() tween(sc, 0.25, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	return sc
end

local function resolveParent(explicit)
	if explicit then return explicit, "explicit" end
	if getHiddenUI then
		local ok, hui = pcall(getHiddenUI)
		if ok and typeof(hui) == "Instance" then return hui, "gethui" end
	end
	local okCG, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCG and coreGui then
		if protectGUI then return coreGui, "CoreGui (protected)" end
		local writable = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if writable then return coreGui, "CoreGui" end
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then pg = LocalPlayer:WaitForChild("PlayerGui", 10) end
	if pg then return pg, "PlayerGui" end
	error("[Auren] No valid parent found")
end

local function cleanupOld()
	local targets = {}
	local ok1, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok1 and cg then table.insert(targets, cg) end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then table.insert(targets, pg) end
	for _, parent in ipairs(targets) do
		for _, gui in ipairs(parent:GetChildren()) do
			if gui:IsA("ScreenGui") and string.find(gui.Name, "^AurenUI_") then
				pcall(function() gui:Destroy() end)
			end
		end
	end
end

--// ══════════════════════════════════════════════════════════
--//  LIBRARY: CreateWindow
--// ══════════════════════════════════════════════════════════
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local Title    = cfg.Title or "Auren"
	local Subtitle = cfg.Subtitle or "v3.0"
	local Size     = cfg.Size or Vector2.new(620, 440)

	cleanupOld()

	local parent, parentName = resolveParent(cfg.Parent)
	print("[Auren] Parent:", parentName)

	local screen = Instance.new("ScreenGui")
	screen.Name = "AurenUI_" .. tostring(math.random(10000, 99999))
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 999999
	screen.Enabled = true
	screen.Parent = parent
	if protectGUI then pcall(protectGUI, screen) end

	local Window = {
		ScreenGui = screen, Tabs = {}, Pages = {}, CurrentTab = 0,
		Size = Size, Accent = Theme.Accent, AccentAlt = Theme.AccentAlt,
		_dragEnabled = true, _bindings = {}, _tabIndex = {}, SavedScripts = {},
	}

	function Window:BindAccent(inst, prop, isAlt, kind)
		table.insert(self._bindings, { Inst = inst, Prop = prop, Alt = isAlt, Kind = kind or "Color" })
	end
	function Window:SetAccent(accent, accentAlt)
		self.Accent = accent; self.AccentAlt = accentAlt
		Theme.Accent = accent; Theme.AccentAlt = accentAlt
		for _, b in ipairs(self._bindings) do
			local col = b.Alt and accentAlt or accent
			if b.Kind == "Color" then b.Inst[b.Prop] = col
			elseif b.Kind == "Gradient" then b.Inst.Color = ColorSequence.new(accent, accentAlt) end
		end
	end

	local vp = (Camera and Camera.ViewportSize) or Vector2.new(1280, 720)

	local root = new("Frame", {
		Name = "Root", Parent = screen,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2),
		Size = UDim2.fromOffset(Size.X, Size.Y),
		BackgroundTransparency = 1, Visible = true,
	})
	local rootScale = addScale(root)

	local main = new("Frame", {
		Name = "Main", Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.02,
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2,
	})
	round(main, 20)
	stroke(main, Theme.Border, 1, 0.55)
	Window.Root = root
	Window.Main = main

	local fader = new("Frame", {
		Parent = root, Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background, BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 900,
	})
	round(fader, 20)

	local header = new("TextButton", {
		Name = "Header", Parent = main,
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 5,
	})

	local icon = new("Frame", {
		Parent = header, Position = UDim2.fromOffset(16, 15),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 6,
	})
	round(icon, 9)
	local iconGrad = gradient(icon, Theme.Accent, Theme.AccentAlt, 45)
	stroke(icon, Color3.new(1, 1, 1), 1, 0.85)
	new("TextLabel", {
		Parent = icon, Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, Text = "A",
		Font = Theme.FontBold, TextSize = 14,
		TextColor3 = Color3.new(1, 1, 1), ZIndex = 7,
	})
	Window:BindAccent(icon, "BackgroundColor3", false)
	Window:BindAccent(iconGrad, nil, false, "Gradient")

	new("TextLabel", {
		Parent = header, Position = UDim2.fromOffset(54, 13),
		Size = UDim2.new(0, 240, 0, 18), BackgroundTransparency = 1,
		Text = Title, Font = Theme.FontBold, TextSize = 15,
		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	})
	new("TextLabel", {
		Parent = header, Position = UDim2.fromOffset(54, 30),
		Size = UDim2.new(0, 240, 0, 14), BackgroundTransparency = 1,
		Text = Subtitle, Font = Theme.Font, TextSize = 11,
		TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	})

	local headerButtons = {}
	local function makeHeaderButton()
		local b = new("TextButton", {
			Parent = header, Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.5,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 6,
		})
		round(b, 8)
		local sc = addScale(b)
		b.MouseEnter:Connect(function()
			tween(sc, 0.18, { Scale = 1.12 })
			tween(b, 0.18, { BackgroundTransparency = 0.2 })
		end)
		b.MouseLeave:Connect(function()
			tween(sc, 0.18, { Scale = 1 })
			tween(b, 0.18, { BackgroundTransparency = 0.5 })
		end)
		table.insert(headerButtons, b)
		return b
	end

	local gearBtn = makeHeaderButton()
	gearBtn.AnchorPoint = Vector2.new(1, 0)
	gearBtn.Position = UDim2.new(1, -96, 0, 16)
	makeSlidersIcon(gearBtn, Theme.SubText)

	local minBtn = makeHeaderButton()
	minBtn.AnchorPoint = Vector2.new(1, 0)
	minBtn.Position = UDim2.new(1, -62, 0, 16)
	local minBar = new("Frame", {
		Parent = minBtn, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(10, 2),
		BackgroundColor3 = Theme.SubText, BorderSizePixel = 0,
	})
	round(minBar, 1)

	local closeBtn = makeHeaderButton()
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -28, 0, 16)
	local closeBars = {}
	for _, rot in ipairs({ 45, -45 }) do
		local bar = new("Frame", {
			Parent = closeBtn, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(10, 2),
			BackgroundColor3 = Theme.SubText,
			BorderSizePixel = 0, Rotation = rot,
		})
		round(bar, 1)
		table.insert(closeBars, bar)
	end
	minBtn.MouseEnter:Connect(function() tween(minBar, 0.15, { BackgroundColor3 = Theme.Yellow }) end)
	minBtn.MouseLeave:Connect(function() tween(minBar, 0.15, { BackgroundColor3 = Theme.SubText }) end)
	closeBtn.MouseEnter:Connect(function()
		for _, b in ipairs(closeBars) do tween(b, 0.15, { BackgroundColor3 = Theme.Red }) end
	end)
	closeBtn.MouseLeave:Connect(function()
		for _, b in ipairs(closeBars) do tween(b, 0.15, { BackgroundColor3 = Theme.SubText }) end
	end)

	local body = new("Frame", {
		Parent = main, Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1, ZIndex = 4,
	})

	local sidebar = new("Frame", {
		Parent = body, Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(0, 156, 1, -12),
		BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.25,
		BorderSizePixel = 0, ZIndex = 4,
	})
	round(sidebar, 14)
	stroke(sidebar, Theme.Border, 1, 0.6)

	local searchBox = new("Frame", {
		Parent = sidebar, Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 32),
		BackgroundColor3 = Theme.SurfaceAlt, BackgroundTransparency = 0.3,
		BorderSizePixel = 0, ZIndex = 8,
	})
	round(searchBox, 9)
	local searchIconHolder = new("Frame", {
		Parent = searchBox, Position = UDim2.fromOffset(9, 9),
		Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 10,
	})
	makeSearchIcon(searchIconHolder, Theme.SubText, 14)
