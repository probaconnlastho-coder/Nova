		sw.MouseLeave:Connect(function() tween(sc, 0.18, { Scale = 1 }) end)
		sw.MouseButton1Click:Connect(function()
			Window:SetAccent(p.A, p.B)
			for j, o in pairs(swatchStrokes) do
				tween(o, 0.2, { Transparency = (j == i) and 0.1 or 1 })
