		{ A = Color3.fromRGB(0,122,255),   B = Color3.fromRGB(88,86,214) },
		{ A = Color3.fromRGB(175,82,222),  B = Color3.fromRGB(255,45,85) },
		{ A = Color3.fromRGB(255,45,85),   B = Color3.fromRGB(255,149,0) },
