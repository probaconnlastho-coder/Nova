		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if mouseOverHeaderButton(input.Position.X, input.Position.Y) then return end
		windowDrag.armed = true; windowDrag.moved = false
		windowDrag.startTouchX = input.Position.X
		windowDrag.startTouchY = input.Position.Y
		windowDrag.startPosX = root.Position.X.Offset
		windowDrag.startPosY = root.Position.Y.Offset
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not windowDrag.armed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - windowDrag.startTouchX
		local dy = input.Position.Y - windowDrag.startTouchY
		if not windowDrag.moved then
			local mag = math.sqrt(dx*dx + dy*dy)
			if mag < DRAG_THRESHOLD then return end
			windowDrag.moved = true
			windowDrag.startTouchX = input.Position.X
			windowDrag.startTouchY = input.Position.Y
			windowDrag.startPosX = root.Position.X.Offset
			windowDrag.startPosY = root.Position.Y.Offset
			dx = 0; dy = 0
			tween(rootScale, 0.15, { Scale = 1.015 }, Enum.EasingStyle.Quart)
		end
		local newX = windowDrag.startPosX + dx
		local newY = windowDrag.startPosY + dy
		local vpNow = (Camera and Camera.ViewportSize) or vp
		newX = math.clamp(newX, -root.AbsoluteSize.X + 110, vpNow.X - 110)
		newY = math.clamp(newY, 0, math.max(0, vpNow.Y - 46))
		root.Position = UDim2.fromOffset(newX, newY)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if windowDrag.armed then
			local wasMoving = windowDrag.moved
			windowDrag.armed = false; windowDrag.moved = false
			if wasMoving then tween(rootScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Quart) end
		end
	end)

	local function wrapControl(state, row, nameLbl, widgets)
		state.__row = row
		state.__nameLbl = nameLbl
		state.__widgets = widgets or {}
		state._disabled = false
		local rawSet = state.Set
		state.Set = function(self, v, silent)
			if self._disabled then return end
			if rawSet then rawSet(self, v, silent) end
			if not silent then Window:_ScheduleAutoSave() end
		end
		function state:SetVisible(v) row.Visible = v == true end
		function state:SetDisabled(d)
			d = d == true
			self._disabled = d
			tween(row, 0.15, { BackgroundTransparency = d and 0.7 or 1 })
			for _, w in ipairs(self.__widgets) do
				if w and w.Parent then
					if w:IsA("TextButton") or w:IsA("TextBox") then
						w.Active = not d
						w.Selectable = not d
					end
				end
			end
			if nameLbl then tween(nameLbl, 0.15, { TextColor3 = d and Theme.SubText or Theme.Text }) end
		end
		function state:SetName(t) if nameLbl then nameLbl.Text = tostring(t) end end
		function state:Destroy() if row and row.Parent then row:Destroy() end end
		return state
	end

