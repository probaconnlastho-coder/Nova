					local rowL = new("Frame", { Parent = listHolder, Size = UDim2.new(1, 0, 0, 30),
						BackgroundTransparency = 1, ZIndex = 10 })
					new("TextLabel", { Parent = rowL, Position = UDim2.fromOffset(0, 0),
