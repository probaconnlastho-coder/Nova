				local state = { Value = 0, Max = 100 }
				function state:Set(value, max)
					if max then state.Max = max end
					value = math.clamp(value, 0, state.Max)
					state.Value = value
					local alpha = state.Max > 0 and (value / state.Max) or 0
					tween(fill, 0.2, { Size = UDim2.fromScale(alpha, 1) })
					pctLbl.Text = math.floor(alpha * 100 + 0.5) .. "%"
				end
				function state:Get() return state.Value end
				return self:_register(wrapControl(state, row, nameLbl))
			end

			return section
		end

