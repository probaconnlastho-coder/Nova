	local Subtitle = cfg.Subtitle or "v4.1"
	local Size     = cfg.Size or Vector2.new(620, 440)
	local ConfigName = cfg.ConfigName or "auren_default"
	local MinSize = Vector2.new(420, 320)

	cleanupOld()

	local parent, parentName = resolveParent(cfg.Parent)
	print("[Auren] Parent:", parentName)

	local screen = Instance.new("ScreenGui")
	screen.Name = "AurenUI_" .. tostring(math.random(10000, 99999))
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 999999
	screen.Enabled = true
	screen.Parent = parent
	if protectGUI then pcall(protectGUI, screen) end

	local Window = {
		ScreenGui = screen, Tabs = {}, Pages = {}, CurrentTab = 0,
		Size = Size, Accent = Theme.Accent, AccentAlt = Theme.AccentAlt,
		_dragEnabled = true, _bindings = {}, _tabIndex = {},
		_controls = {}, _configName = ConfigName,
		_autoSave = false, _autoSaveTimer = nil,
		_notifySound = false, _notifySoundIds = nil,
		_notifyPosition = "top-right", _notifyMax = 5,
	}

	function Window:BindAccent(inst, prop, isAlt, kind)
		table.insert(self._bindings, { Inst = inst, Prop = prop, Alt = isAlt, Kind = kind or "Color" })
	end
	function Window:SetAccent(accent, accentAlt)
		self.Accent = accent; self.AccentAlt = accentAlt
		Theme.Accent = accent; Theme.AccentAlt = accentAlt
		for _, b in ipairs(self._bindings) do
			local col = b.Alt and accentAlt or accent
			if b.Kind == "Color" then b.Inst[b.Prop] = col
			elseif b.Kind == "Gradient" then b.Inst.Color = ColorSequence.new(accent, accentAlt) end
		end
	end
	function Window:_RegisterControl(ctrl) table.insert(self._controls, ctrl) end
	function Window:_ScheduleAutoSave()
		if not self._autoSave then return end
		if self._autoSaveTimer then task.cancel(self._autoSaveTimer) end
		self._autoSaveTimer = task.delay(2, function()
			pcall(function() self:SaveConfig() end)
		end)
	end
	function Window:SetAutoSave(on) self._autoSave = on == true end
	function Window:SetDraggable(on) self._dragEnabled = on == true end

	local vp = (Camera and Camera.ViewportSize) or Vector2.new(1280, 720)

	local root = new("Frame", {
		Name = "Root", Parent = screen,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2),
		Size = UDim2.fromOffset(Size.X, Size.Y),
		BackgroundTransparency = 1, Visible = true,
	})
	local rootScale = addScale(root)

	local main = new("Frame", {
		Name = "Main", Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.02,
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2,
	})
	round(main, 20)
	stroke(main, Theme.Border, 1, 0.55)
	Window.Root = root
	Window.Main = main

	local fader = new("Frame", {
		Parent = root, Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background, BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 900,
	})
	round(fader, 20)

	local resizeHandle = new("TextButton", {
		Parent = main, AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -6, 1, -6), Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 950,
	})
	for i = 1, 3 do
		local len = 4 + i * 3
		local bar = new("Frame", { Parent = resizeHandle, AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -2, 1, -2 - (i - 1) * 4),
			Size = UDim2.fromOffset(len, 2), BackgroundColor3 = Theme.SubText,
			BackgroundTransparency = 0.4, BorderSizePixel = 0, Rotation = -45 })
		round(bar, 1)
	end
	local resizeState = { armed = false, startMouse = nil, startSize = nil, startTL = nil }
	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		resizeState.armed = true
		resizeState.startMouse = UserInputService:GetMouseLocation()
		resizeState.startSize = Vector2.new(root.Size.X.Offset, root.Size.Y.Offset)
		local pos = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
		resizeState.startTL = pos - resizeState.startSize / 2
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not resizeState.armed then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = UserInputService:GetMouseLocation() - resizeState.startMouse
		local vpNow = (Camera and Camera.ViewportSize) or vp
		local newSize = resizeState.startSize + delta
		newSize = Vector2.new(
			math.clamp(newSize.X, MinSize.X, vpNow.X - 40),
			math.clamp(newSize.Y, MinSize.Y, vpNow.Y - 40))
		local newCenter = resizeState.startTL + newSize / 2
		root.Size = UDim2.fromOffset(newSize.X, newSize.Y)
		root.Position = UDim2.fromOffset(newCenter.X, newCenter.Y)
		Window.Size = newSize
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		resizeState.armed = false
	end)

