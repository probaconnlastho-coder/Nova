		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local dx = input.Position.X - floatDrag.startTouchX
		local dy = input.Position.Y - floatDrag.startTouchY
		if not floatDrag.moved then
			local mag = math.sqrt(dx*dx + dy*dy)
			if mag < DRAG_THRESHOLD then return end
			floatDrag.moved = true
			floatDrag.startTouchX = input.Position.X
			floatDrag.startTouchY = input.Position.Y
			floatDrag.startPosX = floating.Position.X.Offset
			floatDrag.startPosY = floating.Position.Y.Offset
