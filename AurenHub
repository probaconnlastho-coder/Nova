	function Window:SaveConfig(slot)
		slot = slot or self._configName
		if not writeFileFn then
			Window:Notify("Unavailable", "writefile not supported.", 3, "warning")
			return
		end
		local data = {
			accent = colorToHex(self.Accent),
			accentAlt = colorToHex(self.AccentAlt),
			size = { self.Size.X, self.Size.Y },
			pos = { root.Position.X.Offset, root.Position.Y.Offset },
			controls = {},
		}
		for _, c in ipairs(self._controls) do
			if c.Id and c.Get then
				local ok, v = pcall(function() return c:Get() end)
				if ok then data.controls[c.Id] = v end
			end
		end
		local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
		if not ok then return end
		local path = slot .. ".auren.json"
		local wrote = pcall(writeFileFn, path, json)
		if wrote then
			Window:Notify("Saved", "Config written.", 3, "success")
		else
			Window:Notify("Save Failed", "Could not write file.", 3, "error")
		end
	end

	function Window:LoadConfig(slot)
		slot = slot or self._configName
		if not (readFileFn and isFileFn) then
			Window:Notify("Unavailable", "readfile not supported.", 3, "warning")
			return
		end
		local path = slot .. ".auren.json"
		local okF = pcall(isFileFn, path)
		if not okF then
			Window:Notify("Not Found", "No config named " .. slot, 3, "warning")
			return
		end
		local ok, raw = pcall(readFileFn, path)
		if not ok or not raw then
			Window:Notify("Load Failed", "Could not read config.", 3, "error")
			return
		end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok2 or type(data) ~= "table" then
			Window:Notify("Load Failed", "Invalid config.", 3, "error")
			return
		end
		if data.accent then
			local a = hexToColor(data.accent)
			local b = hexToColor(data.accentAlt or data.accent)
			if a and b then Window:SetAccent(a, b) end
		end
		if data.size then
			root.Size = UDim2.fromOffset(data.size[1], data.size[2])
			Window.Size = Vector2.new(data.size[1], data.size[2])
		end
		if data.pos then
			root.Position = UDim2.fromOffset(data.pos[1], data.pos[2])
		end
		for _, c in ipairs(self._controls) do
			if c.Id then
				local v = data.controls[c.Id]
				if v ~= nil then pcall(function() c:Set(v, true) end) end
			end
		end
		Window:Notify("Loaded", "Config applied.", 3, "success")
	end

	function Window:DeleteConfig(slot)
		slot = slot or self._configName
		if not delFileFn then
			Window:Notify("Unavailable", "delfile not supported.", 3, "warning")
			return
		end
		local path = slot .. ".auren.json"
		local ok = pcall(delFileFn, path)
		if ok then Window:Notify("Deleted", "Config removed.", 3, "info")
		else Window:Notify("Failed", "Could not delete.", 3, "error") end
	end

	function Window:ListConfigs()
		if not listFilesFn then return {} end
		local ok, files = pcall(listFilesFn, ".")
		if not ok or type(files) ~= "table" then return {} end
		local out = {}
		for _, f in ipairs(files) do
			local name = tostring(f):match("([^/\\]+)%.auren%.json$")
			if name then table.insert(out, name) end
		end
		return out
	end

