					if checks[opt] then
						picked[opt] = not picked[opt] or nil
						checks[opt].Visible = picked[opt] == true
						refreshLbl()
					end
				end
				state.Options = options
				return self:_register(wrapControl(state, row, nameLbl, { head }))
