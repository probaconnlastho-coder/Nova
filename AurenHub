				local hexBox = new("TextBox", { Parent = hexBoxH, Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1, Text = colorToHex(default),
					Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Center,
					ClearTextOnFocus = false, ZIndex = 11 })
				hexBox.FocusLost:Connect(function()
					local c = hexToColor(hexBox.Text)
					if c then
						sliders.R.apply(c.R * 255, false)
						sliders.G.apply(c.G * 255, false)
						sliders.B.apply(c.B * 255, false)
						if callback then task.spawn(callback, state.Value) end
					else
						hexBox.Text = colorToHex(state.Value)
					end
				end)
				local open = false
				local function closeList()
					open = false
					tween(listHolder, 0.28, { Size = UDim2.new(1, 0, 0, 0) },
						Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
				end
				local function openList()
					open = true
					tween(listHolder, 0.32, { Size = UDim2.new(1, 0, 0, 180) }, Enum.EasingStyle.Back)
				end
				head.MouseButton1Click:Connect(function()
					if open then closeList() else openList() end
				end)
				function state:Set(c, silent)
