						Text = label, Font = Theme.FontBold, TextSize = 11,
						TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 })
					local tr = new("Frame", { Parent = rowL, Position = UDim2.fromOffset(24, 12),
						Size = UDim2.new(1, -50, 0, 5),
						BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0, ZIndex = 10 })
					round(tr, UDim.new(1, 0))
					local fl = new("Frame", { Parent = tr, Size = UDim2.new(defaultVal / 255, 0, 1, 0),
						BackgroundColor3 = Window.Accent, BorderSizePixel = 0, ZIndex = 11 })
					round(fl, UDim.new(1, 0))
					local kn = new("Frame", { Parent = tr, AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.new(defaultVal / 255, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12),
						BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 12 })
					round(kn, UDim.new(1, 0))
					local valLbl = new("TextLabel", { Parent = rowL, AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(24, 16),
						BackgroundTransparency = 1, Text = tostring(math.floor(defaultVal)),
						Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.SubText,
						TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 11 })
					local hb = new("TextButton", { Parent = rowL, Position = UDim2.fromOffset(24, 0),
						Size = UDim2.new(1, -50, 0, 30), BackgroundTransparency = 1, Text = "",
						AutoButtonColor = false, ZIndex = 13 })
					local drag = false
					local function apply(v, fire)
						v = math.clamp(v, 0, 255)
						local alpha = v / 255
						fl.Size = UDim2.fromScale(alpha, 1)
						kn.Position = UDim2.new(alpha, 0, 0.5, 0)
						valLbl.Text = tostring(math.floor(v + 0.5))
						local r = math.floor(state.Value.R * 255 + 0.5)
						local g = math.floor(state.Value.G * 255 + 0.5)
						local b = math.floor(state.Value.B * 255 + 0.5)
						if channel == "R" then r = math.floor(v + 0.5) end
						if channel == "G" then g = math.floor(v + 0.5) end
						if channel == "B" then b = math.floor(v + 0.5) end
						state.Value = Color3.fromRGB(r, g, b)
						preview.BackgroundColor3 = state.Value
						swatch.BackgroundColor3 = state.Value
						hexLbl.Text = "#" .. colorToHex(state.Value)
						if fire and callback then task.spawn(callback, state.Value) end
					end
					local function fromInput(input)
						local rel = (input.Position.X - tr.AbsolutePosition.X)
							/ math.max(tr.AbsoluteSize.X, 1)
						apply(rel * 255, true)
					end
					hb.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							drag = true
							fromInput(input)
						end
					end)
					UserInputService.InputChanged:Connect(function(input)
						if not drag then return end
						if input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch then
							fromInput(input)
						end
					end)
					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							drag = false
						end
					end)
					return { apply = apply }
				end
				local sliders = {
					R = mkColorSlider("R", "R", math.floor(default.R * 255)),
					G = mkColorSlider("G", "G", math.floor(default.G * 255)),
					B = mkColorSlider("B", "B", math.floor(default.B * 255)),
				}
				local hexRow = new("Frame", { Parent = listHolder, Size = UDim2.new(1, 0, 0, 28),
