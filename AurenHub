local _autoAfkEnabled = false
local _autoAfkThread
function Library.Util.AutoAFK(on)
	on = on == true
	if on and not _autoAfkEnabled then
		_autoAfkEnabled = true
		_autoAfkThread = task.spawn(function()
			while _autoAfkEnabled do
				task.wait(60)
				pcall(function()
					local vu = game:GetService("VirtualUser")
					vu:CaptureController()
					vu:ClickButton2(Vector2.new())
				end)
			end
		end)
	elseif not on then
		_autoAfkEnabled = false
		if _autoAfkThread then pcall(task.cancel, _autoAfkThread) end
	end
end

function Library.Util.ServerHop()
	if not httpRequest then return false end
	local ok, res = pcall(function()
		return httpRequest({
			Url = string.format(
				"https://games.roblox.com/v1/games/%d/servers/Public?limit=100",
				game.PlaceId),
			Method = "GET",
		})
	end)
	if not ok or not res or not res.Body then return false end
	local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not ok2 or not data or not data.data then return false end
	for _, srv in ipairs(data.data) do
		if srv.id and srv.id ~= game.JobId
			and srv.playing < srv.maxPlayers then
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
			end)
			return true
		end
	end
	return false
end

function Library.Util.Rejoin()
	pcall(function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)
end

function Library.Util.CopyJobId()
	if setClipboard then return pcall(setClipboard, game.JobId) end
	return false
end

function Library.Util.CopyPlaceId()
	if setClipboard then return pcall(setClipboard, tostring(game.PlaceId)) end
	return false
end

function Library.Util.DiscordWebhook(url, content)
	if not httpRequest then return false end
	local ok, res = pcall(function()
		return httpRequest({
			Url = url, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ content = content }),
		})
	end)
	return ok and res and (res.StatusCode == 200 or res.StatusCode == 204)
end

return Library
