				btn.MouseButton1Click:Connect(function()
					state.Listening = not state.Listening
					lbl.Text = state.Listening and "Press key…" or nameOf(state.Value)
					tween(btnStroke, 0.15, {
						Color = state.Listening and Window.Accent or Theme.Border,
						Transparency = state.Listening and 0.15 or 0.5 })
				end)
				UserInputService.InputBegan:Connect(function(input, processed)
					if processed then return end
					if not state.Listening then
						if state.Value and input.KeyCode == state.Value then
							if callback then task.spawn(callback, state.Value) end
						end
						return
					end
					state.Listening = false
					if input.KeyCode == Enum.KeyCode.Escape then
						state:Set(nil)
					else
						state:Set(input.KeyCode)
					end
					tween(btnStroke, 0.15, { Color = Theme.Border, Transparency = 0.5 })
				end)
				return self:_register(wrapControl(state, row, nameLbl, { btn }))
			end

