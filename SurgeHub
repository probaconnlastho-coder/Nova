        TextSize = 12, Font = Enum.Font.SourceSans,
        TextScaled = true, TextWrapped = true, ZIndex = 4,
    }, page.container)
    corner(b, 4); grad(b)
    b.MouseButton1Click:Connect(function()
        playClick()
        if cb then
            local ok, err = pcall(cb)
            if not ok then notif("Error: "..tostring(err)) end
        end
    end)
    return b
