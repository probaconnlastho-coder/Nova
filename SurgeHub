local function killAll()
    runAction(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then h.Health = 0 end
            end
        end
    end, [[
        for _, p in ipairs(game.Players:GetPlayers()) do
            pcall(function()
                local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                if h then h.Health = 0 end
            end)
        end
    ]])
end
local function freezeAll(state)
    runAction(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                for _, d in ipairs(p.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.Anchored = state end
                end
            end
        end
    end, string.format([[
        for _, p in ipairs(game.Players:GetPlayers()) do
            pcall(function()
                for _, d in ipairs(p.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.Anchored = %s end
                end
            end)
        end
    ]], tostring(state)))
end
local function invisibleAll(state)
    runAction(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                for _, d in ipairs(p.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.Transparency = state and 1 or 0 end
                    if d:IsA("Decal") then d.Transparency = state and 1 or 0 end
                end
            end
        end
    end, string.format([[
        for _, p in ipairs(game.Players:GetPlayers()) do
            pcall(function()
                for _, d in ipairs(p.Character:GetDescendants()) do
                    if d:IsA("BasePart") or d:IsA("Decal") then
                        d.Transparency = %s
                    end
                end
            end)
        end
    ]], tostring(state and 1 or 0)))
end
