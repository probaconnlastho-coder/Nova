    RS.RenderStepped:Connect(function(dt)
        f = f + 1; e = e + dt
        if e >= 1 then
            pcall(function() FPSLabel.Text = "FPS: "..f end)
            f = 0; e = 0
        end
    end)
    task.spawn(function()
