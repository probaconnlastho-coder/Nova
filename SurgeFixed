local Pages = {}
local function createPage(name)
    local p = mk("ScrollingFrame", {
        Name = name.."Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 6,
        ScrollBarImageColor3 = Color3.fromRGB(0, 0, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, ClipsDescendants = true, ZIndex = 3,
    }, Content)
    mk("UIGridLayout", {
        CellPadding = UDim2.new(0, 6, 0, 4),
        CellSize = UDim2.new(0, 96, 0, 34),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, p)
    mk("UIPadding", {PaddingTop=UDim.new(0,6), PaddingBottom=UDim.new(0,6), PaddingLeft=UDim.new(0,4), PaddingRight=UDim.new(0,4)}, p)
    Pages[name] = { frame = p, container = p }
    return p
end

local function showPage(name)
    for k, v in pairs(Pages) do v.frame.Visible = (k == name) end
end

