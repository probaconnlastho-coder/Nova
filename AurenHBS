local function spawnVehicle(name, size, color)
	local hrp = getHRP()
	if not hrp then return end
	local v = mk("Model", { Name = "HH_" .. name }, workspace)
	local base = mk("Part", {
		Name = "Chassis",
		Size = size,
		BrickColor = BrickColor.new(color),
		Material = Enum.Material.Metal,
		CFrame = hrp.CFrame * CFrame.new(0, 2, -10)
	}, v)
	local seat = mk("VehicleSeat", {
		Name = "Seat",
		Size = Vector3.new(2, 1, 2),
		BrickColor = BrickColor.new("Really black"),
		CFrame = base.CFrame * CFrame.new(0, size.Y / 2 + 0.5, 0)
	}, v)
	mk("WeldConstraint", { Part0 = base, Part1 = seat }, seat)
	notify(name .. " spawned")
end
