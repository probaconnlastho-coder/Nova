-- ============ HELPERS ============
local function mk(className, props, parent)
	local obj = safeNew(className, props, parent)
	return obj
end

local function corner(parent, radius)
	if not parent then return nil end
	return safeNew("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function stroke(parent, color, thickness)
	if not parent then return nil end
	return safeNew("UIStroke", { Color = color or Color3.new(1, 1, 1), Thickness = thickness or 1 }, parent)
end

