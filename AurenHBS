		mk("UIListLayout", { Padding = UDim.new(0, 2) }, sc)
		local function add(parent, name, depth)
			local x = mk("TextButton", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundColor3 = Color3.new(0, 0, 0),
				Text = string.rep("  ", depth) .. "> " .. name,
				TextColor3 = Color3.new(1, 1, 1),
				Font = Enum.Font.Code,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left
			}, sc)
			corner(x, 4)
			x.MouseButton1Click:Connect(function()
				for _, c in ipairs(x:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				if parent then
					for _, c in ipairs(parent:GetChildren()) do
						if c.Name ~= name then
							add(c, c.Name, depth + 1)
						end
					end
				end
			end)
		end
		for _, c in ipairs(game:GetChildren()) do
			add(c, c.Name, 0)
		end
		notify("DEX")
	end)
end

