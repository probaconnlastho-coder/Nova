local logBuffer = {}
local function pushLog(msg)
	table.insert(logBuffer, os.date("[%H:%M:%S] ") .. msg)
	if #logBuffer > 40 then table.remove(logBuffer, 1) end
	logOutput.Text = "  " .. table.concat(logBuffer, "\n  ")
end
makeButton(Pages.Logs, "Print Player", function() pushLog("User: " .. LocalPlayer.Name .. " ID: " .. LocalPlayer.UserId) end)
