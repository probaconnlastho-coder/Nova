-- Fly
local flying, flyBV, flyBG
local function toggleFly()
	flying = not flying
	if flying then
		local hrp = getHRP()
		if not hrp then return end
		flyBV = mk("BodyVelocity", { MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.new() }, hrp)
		flyBG = mk("BodyGyro", { MaxTorque = Vector3.new(1e5, 1e5, 1e5), P = 1000, CFrame = hrp.CFrame }, hrp)
		notify("Fly ON")
	else
		if flyBV then flyBV:Destroy() end
		if flyBG then flyBG:Destroy() end
		notify("Fly OFF")
	end
end

RunService.RenderStepped:Connect(function()
	if flying and flyBV and flyBG then
		local cf = Camera.CFrame
		local move = Vector3.new()
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
		flyBV.Velocity = move * 60
		flyBG.CFrame = cf
	end
end)

-- Dummy
local function spawnDummy()
	local hrp = getHRP()
	if not hrp then return end
	local d = mk("Model", { Name = "HappyHub_Dummy" }, workspace)
	local base = hrp.CFrame * CFrame.new(0, 0, -6)
	local parts = {}
	local partData = {
		{"HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), true},
		{"Torso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0)},
		{"Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0)},
		{"Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0)},
		{"Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0)},
		{"Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0)},
		{"Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0)}
	}
	for _, x in ipairs(partData) do
		local p = mk("Part", {
			Name = x[1],
			Size = x[2],
			CFrame = base * CFrame.new(x[3]),
			Anchored = x[4] or false,
			BrickColor = BrickColor.new("Really blue")
		}, d)
		if x[1] == "Head" then
			mk("SpecialMesh", { Scale = Vector3.new(1.25, 1.25, 1.25) }, p)
			mk("Decal", { Name = "Face" }, p)
		end
		if x[1] == "HumanoidRootPart" then
			p.Transparency = 0.5
		end
		table.insert(parts, p)
	end
	mk("Humanoid", {}, d)
	for _, p in ipairs(parts) do
		if p.Name ~= "HumanoidRootPart" then
			local w = mk("WeldConstraint", {}, p)
			w.Part0 = parts[1]
			w.Part1 = p
		end
	end
	notify("Dummy")
end

