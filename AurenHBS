-- Melee
local function makeMelee(name, size, color, dmg)
	local c = getChar()
	local tool = mk("Tool", { Name = name, RequiresHandle = true }, c)
	local handle = mk("Part", {
		Name = "Handle",
		Size = size,
		BrickColor = BrickColor.new(color),
		CanCollide = false
	}, tool)
	tool.GripPos = Vector3.new(0, -1, 0)
	tool.Activated:Connect(function()
		local hrp = getHRP()
		if not hrp then return end
		local s = mk("Sound", { SoundId = "rbxassetid://12222216", Volume = 1 }, handle)
		s:Play()
		Debris:AddItem(s, 1)
		local hit = mk("Part", {
			Size = Vector3.new(4, 4, 4),
			CFrame = hrp.CFrame * CFrame.new(0, 0, -4),
			Transparency = 1,
			CanCollide = false,
			Name = "HH_Hit"
		}, workspace)
		Debris:AddItem(hit, 0.1)
		hit.Touched:Connect(function(other)
			local hum = other.Parent:FindFirstChildOfClass("Humanoid")
			if hum and other.Parent ~= c then
				hum:TakeDamage(dmg or 25)
			end
		end)
	end)
	notify(name)
end

-- Gun
local function makeGun(name, size, color, dmg)
	local c = getChar()
	local tool = mk("Tool", { Name = name }, c)
	local handle = mk("Part", {
		Name = "Handle",
		Size = size,
		BrickColor = BrickColor.new(color),
		CanCollide = false
	}, tool)
	tool.GripPos = Vector3.new(0, -0.5, -1)
	tool.Activated:Connect(function()
		local hrp = getHRP()
		if not hrp then return end
		local s = mk("Sound", { SoundId = "rbxassetid://1113117129", Volume = 1 }, handle)
		s:Play()
		Debris:AddItem(s, 1)
		local ray = Ray.new(handle.Position, Camera.CFrame.LookVector * 500)
		local hit, pos = workspace:FindPartOnRay(ray, c)
		if hit then
			local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
			if hum and hit.Parent ~= c then
				hum:TakeDamage(dmg or 35)
			end
			mk("Explosion", {
				Position = pos,
				BlastRadius = 1,
				BlastPressure = 0,
				DestroyJointRadiusPercent = 0
			}, workspace)
		end
	end)
	notify(name)
end

-- Morph
local function morphUser(uid)
	pcall(function()
		local c = getChar()
		local newChar = Players:CreateHumanoidModelFromUserId(uid)
		newChar.Name = LocalPlayer.Name
		local hrp = getHRP()
		if not hrp then return end
		newChar:SetPrimaryPartCFrame(hrp.CFrame)
		newChar.Parent = workspace
		c:Destroy()
		LocalPlayer.Character = newChar
		notify("Morphed")
	end)
end

local function morphName(name)
	local ok, uid = pcall(function()
		return Players:GetUserIdFromNameAsync(name)
	end)
	if ok and uid then
		morphUser(uid)
	else
		notify("Not found")
	end
end

local function spawnNPC(name, uid)
	local hrp = getHRP()
	if not hrp then return end
	local newNPC = Players:CreateHumanoidModelFromUserId(uid or 1)
	newNPC.Name = name or "NPC"
	newNPC:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -6))
	newNPC.Parent = workspace
	notify("NPC: " .. newNPC.Name)
end

local function setFace(id)
	local head = getChar():FindFirstChild("Head")
	if head then
		local f = head:FindFirstChild("face")
		if f then f:Destroy() end
		mk("Decal", { Name = "face", Texture = "rbxassetid://" .. id }, head)
		notify("Face set")
	end
end

local function sendChat(msg)
	pcall(function()
		ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SayMessageRequest"):FireServer(msg, "All")
	end)
end

