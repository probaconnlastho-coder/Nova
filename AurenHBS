	if _G.__music then _G.__music:Destroy() end
	_G.__music = mk("Sound", { SoundId = "rbxassetid://" .. id, Volume = 0.5 }, workspace)
	_G.__music:Play()
	notify("Playing")
end

local function stopMusic()
